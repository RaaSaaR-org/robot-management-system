# SO-101 Sidecar Environment Configuration
# Copy to .env.so101 and adjust values for your setup.

# VLA inference server URL (SmolVLA on phuc-the-ripper or local)
VLA_SERVER_URL=http://192.168.178.40:8000

# Serial port for SO-101 arm
SO101_PORT=/dev/ttyACM0

# Robot identifier (used for calibration file lookup)
SO101_ROBOT_ID=my_so101

# Embodiment type — REQUIRED. The robot-agent resolves the hardware joint order
# (HardwareClient) from this; without it the agent defaults to `h1` and would map
# the wrong joints to the SO-101 arm. Must be `so101` for this arm.
ROBOT_TYPE=so101

# Camera configuration
CAMERA_TYPE=picamera2
WRIST_CAMERA_INDEX=1

# Control loop frequency (Hz)
VLA_HZ=5.0

# --- Real-Time Chunking (RTC) ---
# Smoother arm movements by overlapping inference with execution.
# When enabled, the next action chunk is pre-fetched while the current
# one executes, and overlapping actions are blended at chunk boundaries.
VLA_RTC_ENABLED=false
VLA_RTC_BLEND_STEPS=5
VLA_RTC_CHUNK_OVERLAP=3
