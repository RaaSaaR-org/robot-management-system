<mujoco model="g1_dex3_house_scene">
  <!--
    ==========================================================================
    Agent Mode house scene (TASK-194 follow-up)
    ==========================================================================
    The big-world sibling of g1_dex3_room_scene.xml. Same robot, same base
    actuation, same conventions - only the world grew from one 6x6 m box into a
    12 x 9 m four-room apartment with a 12 m hallway running through it.

    Why a house at all: every Agent Mode number so far was measured inside a
    single room where the far wall is 6 m away and every landmark is in view
    from the spawn pose. That flatters the navigator. Here the robot has to be
    driven room to room, most landmarks are NOT visible from where it starts,
    and a straight line between two rooms usually ends in a wall - which is the
    honest shape of the problem the stage loop actually faces.

      (drawn with '=' and not '-' on purpose: XML forbids a double hyphen inside
      a comment, and an ASCII wall made of them left this whole file unparseable
      by every strict XML tool, while MuJoCo's lenient tinyxml accepted it
      happily. Do not "tidy" these back to hyphens.)

      y
      ^          x = -6                 x = 0                  x = +6
      |  +4.5  +======================+===+========================+
      |        |  KITCHEN             |   |  LIVING ROOM           |
      |        |  counter, fridge     |   |  sofa, plant (west),   |
      |        |                      |   |  tv (east), table +    |
      |        |                      |   |  red hat (NE corner)   |
      |  +1.5  +====[yellow door]=====+===+======[wide arch]=======+
      |        |                                                   |
      |   0.0  |  H A L L W A Y   (robot spawns at 0,0 facing +x)  |
      |        |                          crate                    |
      |  -1.5  +====[violet door]=====+===+=====[orange door]======+
      |        |  BEDROOM             |   |  WORKSHOP              |
      |        |  bed, lamp           |   |  workbench, toolbox,   |
      |        |                      |   |  ladder, person        |
      |  -4.5  +======================+===+========================+
      +===============================================================> x

    Doorways are colour-coded on purpose. A 7B vision model cannot tell two
    white door frames apart, but it reliably names "the yellow door" - so the
    door itself becomes a navigable landmark and a multi-room mission can be
    expressed as a chain of goto legs instead of dead-reckoned walks.

    Room contents are chosen the same way as in the room scene: distinct in
    colour AND in shape, because the vision model gets one 640x480 head-camera
    frame and nothing else. Everything a navigation may target stands with mass
    in the 0.15-1.80 m band the LiDAR cone query uses - furniture below the band
    (a rug) or above it (a ceiling lamp) is invisible to range and would produce
    a bearing with no distance, which is a documented degradation and not
    something this scene should manufacture on purpose.

    Unchanged from the room scene and load-bearing: PELVIS_Z = 0.807 keeps the
    feet clear of the floor (mj_forward gives ncon = 0 at rest) and sim_node.py's
    weight-0 hold pose must stay LATCHED. Both are covered by e2e_loco_check.py
    checks 2 and 11. Do not "tidy" the pelvis height to make the robot look
    better standing - it ratchets the ankles on the first step.

    World -> compass convention, same as the room scene: +x = 0 deg bearing,
    counter-clockwise positive, so +y = +90 deg. base_yaw is the robot heading.

    Sits directly in mjcf/ like the other scenes, so mesh paths of the form
    g1_dex3/meshes/*.STL inside the robot include resolve next to this file.
    ==========================================================================
  -->
  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <include file="g1_dex3/g1_43dof_planarbase.xml"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.45 0.55 0.65" rgb2="0.15 0.18 0.22"
             width="512" height="3072"/>
    <texture type="2d" name="housefloor" builtin="checker" mark="edge"
             rgb1="0.34 0.32 0.29" rgb2="0.26 0.25 0.22" markrgb="0.5 0.5 0.5"
             width="300" height="300"/>
    <material name="housefloor" texture="housefloor" texuniform="true"
              texrepeat="12 12" reflectance="0.05"/>

    <material name="wall" rgba="0.86 0.84 0.80 1" specular="0.05" shininess="0.05"/>
    <material name="wall_inner" rgba="0.80 0.79 0.76 1" specular="0.05" shininess="0.05"/>

    <!-- Door frames: one hue per doorway, so "the yellow door" is a target. -->
    <material name="door_yellow" rgba="0.95 0.85 0.25 1" specular="0.1" shininess="0.1"/>
    <material name="door_violet" rgba="0.62 0.35 0.85 1" specular="0.1" shininess="0.1"/>
    <material name="door_orange" rgba="0.95 0.50 0.15 1" specular="0.1" shininess="0.1"/>
    <material name="arch_white" rgba="0.97 0.97 0.95 1" specular="0.1" shininess="0.1"/>

    <material name="wood_light" rgba="0.72 0.55 0.34 1" specular="0.2" shininess="0.2"/>
    <material name="wood_dark" rgba="0.36 0.25 0.16 1" specular="0.15" shininess="0.15"/>
    <material name="hat_red" rgba="0.78 0.12 0.12 1" specular="0.3" shininess="0.3"/>
    <material name="shelf_dark" rgba="0.22 0.20 0.19 1" specular="0.1" shininess="0.1"/>

    <material name="steel" rgba="0.78 0.80 0.83 1" specular="0.5" shininess="0.5"/>
    <material name="counter_white" rgba="0.92 0.92 0.90 1" specular="0.2" shininess="0.2"/>
    <material name="counter_top" rgba="0.30 0.32 0.35 1" specular="0.4" shininess="0.4"/>

    <material name="sofa_teal" rgba="0.10 0.45 0.48 1" specular="0.1" shininess="0.1"/>
    <material name="tv_black" rgba="0.06 0.06 0.07 1" specular="0.5" shininess="0.6"/>
    <material name="plant_green" rgba="0.20 0.55 0.22 1" specular="0.1" shininess="0.1"/>
    <material name="pot_terra" rgba="0.70 0.36 0.22 1" specular="0.1" shininess="0.1"/>

    <material name="bed_white" rgba="0.93 0.93 0.95 1" specular="0.1" shininess="0.1"/>
    <material name="bed_blue" rgba="0.25 0.35 0.62 1" specular="0.1" shininess="0.1"/>
    <material name="lamp_yellow" rgba="0.98 0.90 0.55 1" specular="0.2" shininess="0.3"/>

    <material name="toolbox_red" rgba="0.80 0.15 0.12 1" specular="0.3" shininess="0.3"/>
    <material name="ladder_alu" rgba="0.72 0.74 0.78 1" specular="0.5" shininess="0.5"/>
    <material name="crate" rgba="0.62 0.46 0.26 1" specular="0.1" shininess="0.1"/>
    <material name="chair_blue" rgba="0.15 0.35 0.75 1" specular="0.2" shininess="0.2"/>

    <material name="person_shirt" rgba="0.15 0.62 0.32 1" specular="0.1" shininess="0.1"/>
    <material name="person_skin" rgba="0.90 0.74 0.62 1" specular="0.1" shininess="0.1"/>
    <material name="person_legs" rgba="0.20 0.22 0.30 1" specular="0.1" shininess="0.1"/>
  </asset>

  <worldbody>
    <!-- One directional key light plus a fill per room. A single overhead light
         leaves the rooms behind the interior walls dark enough that the vision
         model starts answering "a dark room" instead of naming the furniture. -->
    <light pos="0 0 4.0" dir="0 0 -1" directional="true" diffuse="0.55 0.55 0.55"/>
    <light pos="-3.5 3.0 2.6" dir="0 0 -1" diffuse="0.35 0.35 0.35"/>
    <light pos="3.5 3.0 2.6" dir="0 0 -1" diffuse="0.35 0.35 0.35"/>
    <light pos="-3.5 -3.0 2.6" dir="0 0 -1" diffuse="0.35 0.35 0.35"/>
    <light pos="3.5 -3.0 2.6" dir="0 0 -1" diffuse="0.35 0.35 0.35"/>
    <light pos="0 0 2.6" dir="0 0 -1" diffuse="0.30 0.30 0.30"/>

    <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="housefloor"
          friction="0.8" condim="3"/>

    <!-- ================= Outer shell: 12 x 9 m, 2.5 m high ================= -->
    <geom name="wall_north" type="box" size="6.05 0.05 1.25" pos="0 4.5 1.25" material="wall"/>
    <geom name="wall_south" type="box" size="6.05 0.05 1.25" pos="0 -4.5 1.25" material="wall"/>
    <geom name="wall_east"  type="box" size="0.05 4.5 1.25" pos="6 0 1.25" material="wall"/>
    <geom name="wall_west"  type="box" size="0.05 4.5 1.25" pos="-6 0 1.25" material="wall"/>

    <!-- ===== Interior wall y = +1.5 (hallway | kitchen, living room) =======
         Two openings: the kitchen door spans x [-4.2, -3.0] (1.2 m) and the
         living-room arch spans x [1.6, 3.4] (1.8 m). Segment extents are
         written as the gap they leave, not as a centre and a half-size, because
         every time this was edited it was the GAP that mattered. -->
    <geom name="wall_n_a" type="box" size="0.90 0.05 1.25" pos="-5.10 1.5 1.25" material="wall_inner"/>
    <geom name="wall_n_b" type="box" size="2.30 0.05 1.25" pos="-0.70 1.5 1.25" material="wall_inner"/>
    <geom name="wall_n_c" type="box" size="1.30 0.05 1.25" pos="4.70 1.5 1.25" material="wall_inner"/>

    <!-- ===== Interior wall y = -1.5 (hallway | bedroom, workshop) ==========
         Bedroom door x [-4.2, -3.0], workshop door x [1.9, 3.1]. -->
    <geom name="wall_s_a" type="box" size="0.90 0.05 1.25" pos="-5.10 -1.5 1.25" material="wall_inner"/>
    <geom name="wall_s_b" type="box" size="2.45 0.05 1.25" pos="-0.55 -1.5 1.25" material="wall_inner"/>
    <geom name="wall_s_c" type="box" size="1.45 0.05 1.25" pos="4.55 -1.5 1.25" material="wall_inner"/>

    <!-- ===== Room dividers at x = 0, north and south of the hallway ======== -->
    <geom name="wall_div_n" type="box" size="0.05 1.50 1.25" pos="0 3.0 1.25" material="wall_inner"/>
    <geom name="wall_div_s" type="box" size="0.05 1.50 1.25" pos="0 -3.0 1.25" material="wall_inner"/>

    <!-- ===== Door frames: the colour IS the landmark ======================= -->
    <!-- Kitchen, yellow, gap x [-4.2, -3.0] -->
    <geom name="door_kitchen_l" type="box" size="0.05 0.07 1.05" pos="-4.20 1.5 1.05" material="door_yellow"/>
    <geom name="door_kitchen_r" type="box" size="0.05 0.07 1.05" pos="-3.00 1.5 1.05" material="door_yellow"/>
    <geom name="door_kitchen_t" type="box" size="0.65 0.07 0.05" pos="-3.60 1.5 2.15" material="door_yellow"/>
    <!-- Bedroom, violet, gap x [-4.2, -3.0] -->
    <geom name="door_bedroom_l" type="box" size="0.05 0.07 1.05" pos="-4.20 -1.5 1.05" material="door_violet"/>
    <geom name="door_bedroom_r" type="box" size="0.05 0.07 1.05" pos="-3.00 -1.5 1.05" material="door_violet"/>
    <geom name="door_bedroom_t" type="box" size="0.65 0.07 0.05" pos="-3.60 -1.5 2.15" material="door_violet"/>
    <!-- Workshop, orange, gap x [1.9, 3.1] -->
    <geom name="door_workshop_l" type="box" size="0.05 0.07 1.05" pos="1.90 -1.5 1.05" material="door_orange"/>
    <geom name="door_workshop_r" type="box" size="0.05 0.07 1.05" pos="3.10 -1.5 1.05" material="door_orange"/>
    <geom name="door_workshop_t" type="box" size="0.65 0.07 0.05" pos="2.50 -1.5 2.15" material="door_orange"/>
    <!-- Living room, a wide white arch rather than a door: the one opening the
         robot is meant to walk through head-on from the hallway. -->
    <geom name="arch_living_l" type="box" size="0.06 0.08 1.15" pos="1.60 1.5 1.15" material="arch_white"/>
    <geom name="arch_living_r" type="box" size="0.06 0.08 1.15" pos="3.40 1.5 1.15" material="arch_white"/>
    <geom name="arch_living_t" type="box" size="0.96 0.08 0.10" pos="2.50 1.5 2.40" material="arch_white"/>

    <!-- ====================================================================
         KITCHEN  (north-west, x [-6, 0], y [1.5, 4.5])
         ==================================================================== -->
    <body name="kitchen_counter" pos="-3.40 4.05 0">
      <geom name="counter_body" type="box" size="1.70 0.32 0.44" pos="0 0 0.44"
            material="counter_white" friction="0.6" condim="3"/>
      <geom name="counter_slab" type="box" size="1.75 0.36 0.03" pos="0 0 0.91"
            material="counter_top" friction="0.6" condim="3"/>
      <geom name="counter_sink" type="box" size="0.28 0.22 0.05" pos="0.80 0 0.90"
            material="steel"/>
    </body>

    <body name="fridge" pos="-5.40 2.50 0">
      <geom name="fridge_body" type="box" size="0.36 0.36 0.85" pos="0 0 0.85"
            material="steel" friction="0.6" condim="3"/>
      <geom name="fridge_handle" type="box" size="0.03 0.03 0.30" pos="0.38 -0.24 1.20"
            material="counter_top"/>
    </body>

    <!-- ====================================================================
         LIVING ROOM  (north-east, x [0, 6], y [1.5, 4.5])
         The table with the red hat is carried over from the room scene on
         purpose: it is the object every earlier recording navigated to, so the
         same measurement can be compared across the two worlds.
         ==================================================================== -->
    <!-- Living-room layout note, because it looks arbitrary and is not: the robot
         enters through the arch at x = 2.5 and everything it is asked to walk to has
         to be FAR ENOUGH AWAY to be walked to. With the table where it first sat, at
         (3.6, 2.45), its nearest edge was 0.50 m from the entry pose - inside the
         0.6 m arrival radius, so `goto table` would have declared arrival without
         taking a step. Sofa west, table into the far north-east corner, tv onto the
         south end of the east wall: now the table is 2.15 m out and the approach is
         three stages of a real navigation. -->
    <body name="sofa" pos="1.60 3.95 0">
      <geom name="sofa_seat" type="box" size="1.05 0.42 0.16" pos="0 0 0.28"
            material="sofa_teal" friction="0.6" condim="3"/>
      <geom name="sofa_back" type="box" size="1.05 0.14 0.30" pos="0 0.32 0.62"
            material="sofa_teal"/>
      <geom name="sofa_arm_l" type="box" size="0.12 0.46 0.26" pos="-0.95 0 0.55"
            material="sofa_teal"/>
      <geom name="sofa_arm_r" type="box" size="0.12 0.46 0.26" pos="0.95 0 0.55"
            material="sofa_teal"/>
    </body>

    <body name="table" pos="5.00 3.70 0">
      <geom name="table_top" type="box" size="0.60 0.40 0.03" pos="0 0 0.72"
            material="wood_light" friction="0.6" condim="3"/>
      <geom name="table_leg_a" type="box" size="0.035 0.035 0.36" pos="0.55 0.35 0.36"
            material="wood_light"/>
      <geom name="table_leg_b" type="box" size="0.035 0.035 0.36" pos="-0.55 0.35 0.36"
            material="wood_light"/>
      <geom name="table_leg_c" type="box" size="0.035 0.035 0.36" pos="0.55 -0.35 0.36"
            material="wood_light"/>
      <geom name="table_leg_d" type="box" size="0.035 0.035 0.36" pos="-0.55 -0.35 0.36"
            material="wood_light"/>
    </body>

    <body name="hat" pos="5.00 3.70 0.775">
      <freejoint name="hat_freejoint"/>
      <geom name="hat_brim" type="cylinder" size="0.15 0.008" pos="0 0 0.008" mass="0.06"
            material="hat_red" friction="0.7" condim="3"/>
      <geom name="hat_crown" type="cylinder" size="0.095 0.055" pos="0 0 0.07" mass="0.06"
            material="hat_red" friction="0.7" condim="3"/>
    </body>

    <body name="tv" pos="5.75 2.10 0">
      <geom name="tv_stand" type="box" size="0.14 0.55 0.24" pos="0 0 0.24"
            material="wood_dark" friction="0.6" condim="3"/>
      <geom name="tv_panel" type="box" size="0.04 0.62 0.36" pos="-0.06 0 0.86"
            material="tv_black"/>
    </body>

    <body name="plant" pos="0.60 2.20 0">
      <geom name="plant_pot" type="cylinder" size="0.20 0.22" pos="0 0 0.22"
            material="pot_terra" friction="0.6" condim="3"/>
      <geom name="plant_stem" type="capsule" size="0.04" fromto="0 0 0.44 0 0 0.95"
            material="plant_green"/>
      <geom name="plant_leaf_a" type="ellipsoid" size="0.30 0.16 0.12" pos="0.16 0 1.05"
            material="plant_green"/>
      <geom name="plant_leaf_b" type="ellipsoid" size="0.16 0.30 0.12" pos="-0.10 0.14 1.14"
            material="plant_green"/>
      <geom name="plant_leaf_c" type="ellipsoid" size="0.26 0.18 0.11" pos="-0.06 -0.18 0.98"
            material="plant_green"/>
    </body>

    <!-- ====================================================================
         BEDROOM  (south-west, x [-6, 0], y [-4.5, -1.5])
         ==================================================================== -->
    <body name="bed" pos="-4.30 -3.40 0">
      <geom name="bed_frame" type="box" size="0.95 1.05 0.14" pos="0 0 0.14"
            material="wood_dark" friction="0.6" condim="3"/>
      <geom name="bed_mattress" type="box" size="0.90 1.00 0.12" pos="0 0 0.40"
            material="bed_white" friction="0.6" condim="3"/>
      <geom name="bed_pillow" type="box" size="0.62 0.20 0.07" pos="0 -0.74 0.59"
            material="bed_white"/>
      <geom name="bed_blanket" type="box" size="0.90 0.52 0.05" pos="0 0.45 0.57"
            material="bed_blue"/>
      <geom name="bed_head" type="box" size="0.95 0.06 0.36" pos="0 -1.05 0.60"
            material="wood_dark"/>
    </body>

    <body name="lamp" pos="-1.30 -3.80 0">
      <geom name="lamp_base" type="cylinder" size="0.18 0.03" pos="0 0 0.03"
            material="wood_dark" friction="0.6" condim="3"/>
      <geom name="lamp_pole" type="capsule" size="0.028" fromto="0 0 0.06 0 0 1.32"
            material="steel"/>
      <geom name="lamp_shade" type="cylinder" size="0.24 0.20" pos="0 0 1.50"
            material="lamp_yellow"/>
    </body>

    <!-- ====================================================================
         WORKSHOP  (south-east, x [0, 6], y [-4.5, -1.5])
         ==================================================================== -->
    <body name="workbench" pos="4.40 -4.00 0">
      <geom name="bench_top" type="box" size="1.20 0.40 0.05" pos="0 0 0.86"
            material="wood_dark" friction="0.6" condim="3"/>
      <geom name="bench_leg_a" type="box" size="0.06 0.06 0.43" pos="1.10 0.32 0.43"
            material="wood_dark"/>
      <geom name="bench_leg_b" type="box" size="0.06 0.06 0.43" pos="-1.10 0.32 0.43"
            material="wood_dark"/>
      <geom name="bench_leg_c" type="box" size="0.06 0.06 0.43" pos="1.10 -0.32 0.43"
            material="wood_dark"/>
      <geom name="bench_leg_d" type="box" size="0.06 0.06 0.43" pos="-1.10 -0.32 0.43"
            material="wood_dark"/>
      <geom name="toolbox" type="box" size="0.28 0.18 0.16" pos="-0.55 0 1.07"
            material="toolbox_red" friction="0.6" condim="3"/>
    </body>

    <body name="ladder" pos="1.35 -3.70 0">
      <geom name="ladder_rail_l" type="box" size="0.04 0.04 0.95" pos="-0.28 0 0.95"
            material="ladder_alu"/>
      <geom name="ladder_rail_r" type="box" size="0.04 0.04 0.95" pos="0.28 0 0.95"
            material="ladder_alu"/>
      <geom name="ladder_step_0" type="box" size="0.28 0.035 0.02" pos="0 0 0.35"
            material="ladder_alu"/>
      <geom name="ladder_step_1" type="box" size="0.28 0.035 0.02" pos="0 0 0.75"
            material="ladder_alu"/>
      <geom name="ladder_step_2" type="box" size="0.28 0.035 0.02" pos="0 0 1.15"
            material="ladder_alu"/>
      <geom name="ladder_step_3" type="box" size="0.28 0.035 0.02" pos="0 0 1.55"
            material="ladder_alu"/>
    </body>

    <!-- ====================================================================
         HALLWAY
         The shelf gives the 12 m corridor a landmark that is not a door, and
         the crate sits 0.55 m off the centre line: close enough that the
         forward cone clips it on the way past, far enough that it does not
         block the corridor. It is there so the clearance clamp has something
         real to clamp against on camera.
         ==================================================================== -->
    <body name="shelf" pos="-1.60 1.25 0">
      <geom name="shelf_side_l" type="box" size="0.03 0.18 0.85" pos="-0.55 0 0.85"
            material="shelf_dark"/>
      <geom name="shelf_side_r" type="box" size="0.03 0.18 0.85" pos="0.55 0 0.85"
            material="shelf_dark"/>
      <geom name="shelf_board_0" type="box" size="0.58 0.18 0.02" pos="0 0 0.42"
            material="shelf_dark"/>
      <geom name="shelf_board_1" type="box" size="0.58 0.18 0.02" pos="0 0 0.94"
            material="shelf_dark"/>
      <geom name="shelf_board_2" type="box" size="0.58 0.18 0.02" pos="0 0 1.46"
            material="shelf_dark"/>
    </body>

    <!-- Blue chair at the east end of the corridor. Put there by the preflight's
         "what can the head camera name here" check, which found the mid-hallway
         waypoint looking down 3.5 m of empty corridor at a blank wall: nothing for
         the vision model to name and nothing for a viewer to look at. It also makes
         the "chair" label honest - the model reported one in this house before there
         was one, and a hallucinated label that later becomes real is much easier to
         reason about than one that stays imaginary. -->
    <body name="chair" pos="5.20 0.85 0">
      <geom name="chair_seat" type="box" size="0.22 0.22 0.03" pos="0 0 0.45"
            material="chair_blue" friction="0.6" condim="3"/>
      <geom name="chair_back" type="box" size="0.22 0.03 0.28" pos="0 0.19 0.76"
            material="chair_blue"/>
      <geom name="chair_leg_a" type="box" size="0.025 0.025 0.225" pos="0.18 0.18 0.225"
            material="chair_blue"/>
      <geom name="chair_leg_b" type="box" size="0.025 0.025 0.225" pos="-0.18 0.18 0.225"
            material="chair_blue"/>
      <geom name="chair_leg_c" type="box" size="0.025 0.025 0.225" pos="0.18 -0.18 0.225"
            material="chair_blue"/>
      <geom name="chair_leg_d" type="box" size="0.025 0.025 0.225" pos="-0.18 -0.18 0.225"
            material="chair_blue"/>
    </body>

    <body name="crate" pos="2.90 -0.72 0">
      <geom name="crate_box" type="box" size="0.30 0.30 0.30" pos="0 0 0.30"
            material="crate" friction="0.7" condim="3"/>
      <geom name="crate_lid" type="box" size="0.32 0.32 0.03" pos="0 0 0.63"
            material="wood_dark"/>
    </body>

    <!-- ====================================================================
         Person figure, in the workshop.
         A crude standing figure, not a person model: the idle watcher only ever
         asks the VLM "is a person in the image?" - no faces, no identities,
         nothing to recognise. Mocap body so a test can teleport it in and out
         of view; collision off so it can never trip the robot.
         ==================================================================== -->
    <body name="person" pos="2.60 -2.55 0" mocap="true">
      <geom name="person_leg_l" type="capsule" size="0.055" fromto="0.0 0.09 0.03 0.0 0.09 0.82"
            material="person_legs" contype="0" conaffinity="0"/>
      <geom name="person_leg_r" type="capsule" size="0.055" fromto="0.0 -0.09 0.03 0.0 -0.09 0.82"
            material="person_legs" contype="0" conaffinity="0"/>
      <geom name="person_torso" type="capsule" size="0.145" fromto="0 0 0.85 0 0 1.34"
            material="person_shirt" contype="0" conaffinity="0"/>
      <geom name="person_arm_l" type="capsule" size="0.045" fromto="0 0.17 1.30 0 0.21 0.88"
            material="person_shirt" contype="0" conaffinity="0"/>
      <geom name="person_arm_r" type="capsule" size="0.045" fromto="0 -0.17 1.30 0 -0.21 0.88"
            material="person_shirt" contype="0" conaffinity="0"/>
      <geom name="person_head" type="sphere" size="0.105" pos="0 0 1.48"
            material="person_skin" contype="0" conaffinity="0"/>
    </body>

    <!-- Debug / recording cameras. The agent never uses either: it only ever
         reads the head camera on the robot itself. -->
    <camera name="house_overview" pos="0 -0.6 15.0" xyaxes="1 0 0 0 1 0" fovy="48"/>
    <camera name="house_iso" pos="-9.5 -8.5 7.6" xyaxes="0.667 -0.745 0 0.430 0.385 0.816"
            fovy="52"/>
    <!-- Follows the robot from a fixed perch south of the house: `targetbody` keeps
         the position and re-aims at the pelvis, so one camera works in every room
         instead of needing one per room. The height is not a taste decision - a
         lower perch is blocked by the y = -1.5 interior wall exactly when the robot
         is in the hallway, which is where it spends half the run. From (0, -6.5,
         10.5) the sightline crosses that wall at z = 3.2 m, clear of its 2.5 m top,
         and still clears the y = +1.5 wall for a robot in the living room. -->
    <camera name="house_follow" mode="targetbody" target="pelvis" pos="0 -6.5 10.5"
            fovy="20"/>
  </worldbody>
</mujoco>
