+    def _task223_log(self, action_data=None):
+        """NeoDEM TASK-223 lead 3: report the truth from inside the sim, for free.
+
+        Everything the external `isaac_gait_probe.py` cannot see, and everything it
+        currently sees through a scrambled quaternion:
+
+        * `projected_gravity_b` is the convention-free uprightness test. Isaac Lab
+          computes it internally, so no quaternion-order bug can reach it: it reads
+          (0, 0, -1) when the base is upright and its z component is cos(tilt).
+        * step 0 is printed *before* the first action is ever applied, which is the
+          observation lead 3 asks for: is the robot upright and in its init crouch at
+          physics step 0, or has it already left the pose before the first `rt/lowstate`
+          frame is published?
+        * the joint-name list settles, once, whether `all_joint_names[:29]` equals
+          `old_action_joints_names`. `get_action` indexes the 29-wide `delayed_actions`
+          with `self.action_to_indices`, which are indices into the 43-joint
+          articulation -- correct only if those two orders coincide.
+
+        Wrapped in its own try/except so a logging failure can never be mistaken for
+        the caller's "Get DDS action failed".
+        """
+        try:
+            n = self.sim_step_counter
+            if n % 25 != 0 and n > 5:
+                return
+            d = self.env.scene["robot"].data
+            pg = d.projected_gravity_b.torch[0] if hasattr(d.projected_gravity_b, "torch") \
+                else d.projected_gravity_b[0]
+            q = d.root_quat_w.torch[0] if hasattr(d.root_quat_w, "torch") else d.root_quat_w[0]
+            pos = d.root_pos_w.torch[0] if hasattr(d.root_pos_w, "torch") else d.root_pos_w[0]
+            # Isaac Lab 3.0 quaternions are (x, y, z, w) -- wp.quatf. See
+            # isaaclab/utils/warp/proxy_array.py:130-134 and base_rigid_object_data.py:413.
+            qx, qy, qz, qw = (float(v) for v in q[:4])
+            import math as _m
+            roll = _m.atan2(2 * (qw * qx + qy * qz), 1 - 2 * (qx * qx + qy * qy))
+            pitch = _m.asin(max(-1.0, min(1.0, 2 * (qw * qy - qz * qx))))
+            jp = d.joint_pos.torch if hasattr(d.joint_pos, "torch") else d.joint_pos
+            jv = d.joint_vel.torch if hasattr(d.joint_vel, "torch") else d.joint_vel
+            dj = self.default_action_positions
+            dj = dj.torch if hasattr(dj, "torch") else dj
+            legs = self.action_to_indices
+            if n == 0:
+                print(f"[TASK-223] all_joint_names ({len(self.all_joint_names)}) = "
+                      f"{list(self.all_joint_names)}", flush=True)
+                print(f"[TASK-223] action_to_indices  = {self.action_to_indices}", flush=True)
+                print(f"[TASK-223] old_action_indices = {self.old_action_indices}", flush=True)
+                print("[TASK-223] indexing is sound iff old_action_indices == list(range(29)) "
+                      "and every action_to_indices entry is < 29", flush=True)
+                print(f"[TASK-223] leg defaults = "
+                      f"{[round(float(dj[0, i]), 4) for i in legs]}", flush=True)
+            print(f"[TASK-223] step={n:5d} z={float(pos[2]):+.4f} "
+                  f"proj_grav=({float(pg[0]):+.3f},{float(pg[1]):+.3f},{float(pg[2]):+.3f}) "
+                  f"roll={roll:+.4f} pitch={pitch:+.4f} "
+                  f"leg_q={[round(float(jp[0, i]), 3) for i in legs]} "
+                  f"leg_dq_absmax={max(abs(float(jv[0, i])) for i in legs):.3f} "
+                  f"a_absmax={(float(action_data.abs().max()) if action_data is not None else float('nan')):.3f}",
+                  flush=True)
+        except Exception as e:                                   # never mask the caller
+            print(f"[TASK-223] log failed: {type(e).__name__}: {e}", flush=True)
+
     def get_action(self, env) -> Optional[torch.Tensor]:
