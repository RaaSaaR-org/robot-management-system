diff --git a/tasks/common_observations/camera_state.py b/tasks/common_observations/camera_state.py
index 28be26a..9f496d1 100644
--- a/tasks/common_observations/camera_state.py
+++ b/tasks/common_observations/camera_state.py
@@ -91,6 +91,18 @@ def get_camera_image(
         _camera_cache['last_scene_id'] = scene_id
 
 
+    # NeoDEM patch (TASK-204): bail out on a non-capture frame BEFORE the copies.
+    # Everything below is dead work when frame_step != 0 -- the images are consumed
+    # only inside the `frame_step == 0` enqueue at the end of this function, and the
+    # return value is the same constant placeholder either way. Without this the
+    # GPU->host `.cpu().numpy()` copies for all three cameras ran on EVERY control
+    # step and were then discarded: measured 39 ms of a 55 ms control step, i.e. 70%
+    # of the loop, holding the sim at ~17 Hz against a policy that wants ~100 Hz.
+    # `write_interval_steps` was always meant to gate this; it only ever gated the
+    # shared-memory write, which is the cheap half.
+    if _camera_cache['frame_step'] != 0:
+        return _return_placeholder
+
     if _camera_cache['frame_step'] == 0:
         try:
             dt = getattr(env, 'physics_dt', 0.02)
