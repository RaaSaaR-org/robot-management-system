# ──────────────────────────────────────────────────────────────
# NeoDEM Robot Agent — Environment Variables
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────

# ── LLM Provider ────────────────────────────────────────────
# Provider: "gemini" (default), "openrouter" or "ollama" (local GPU)
# LLM_PROVIDER=gemini

# Gemini (default provider)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter (alternative — free tier available at $0 cost)
# OPENROUTER_API_KEY=your_openrouter_key_here

# Ollama (local — no API key needed; install from https://ollama.com and
# pull the model first, e.g. `ollama pull gpt-oss:20b`)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Override default model (optional)
# Gemini default: gemini-2.5-flash
# OpenRouter default: stepfun/step-3.5-flash:free
# Ollama default: gpt-oss:20b
# LLM_MODEL=

# ── Server Configuration ───────────────────────────────────
PORT=41243
SERVER_URL=http://localhost:3001
PUBLIC_URL=http://localhost:41243

# ── Robot Identity ──────────────────────────────────────────
ROBOT_ID=sim-robot-001
ROBOT_NAME=SimBot-01
ROBOT_MODEL=SimBot H1
# ROBOT_TYPE=generic

# ── Robot Physical Characteristics ──────────────────────────
# Options: lightweight, standard, heavy-duty
ROBOT_CLASS=standard
# Maximum payload capacity in kilograms
MAX_PAYLOAD_KG=10
# Robot description for AI context
ROBOT_DESCRIPTION=A versatile humanoid robot for general tasks

# ── Initial Position ────────────────────────────────────────
INITIAL_X=10.0
INITIAL_Y=10.0
INITIAL_ZONE=Warehouse A
INITIAL_FLOOR=1

# ── Hardware Sidecar (SO-101) ───────────────────────────────
# URL of the LeRobot hardware sidecar (real servo/camera control)
# HARDWARE_SIDECAR_URL=http://localhost:8765

# ── VLA Inference ───────────────────────────────────────────
# Enable VLA inference pipeline
# VLA_ENABLED=false
# VLA_SERVER_URL=http://localhost:8000

# gRPC connection (alternative to REST)
# VLA_INFERENCE_HOST=localhost
# VLA_INFERENCE_PORT=50051

# REST fallback
# VLA_REST_FALLBACK_URL=http://localhost:8000

# VLA tuning
# VLA_TIMEOUT_MS=30000
# VLA_CONNECTION_POOL_SIZE=2
# VLA_HEALTH_CHECK_INTERVAL_MS=30000
# VLA_ROBOT_PORT=41243

# ── Federated Learning ─────────────────────────────────────
# FEDERATED_ENABLED=false
# FEDERATED_BRIDGE_PORT=41244
# FEDERATED_POLL_INTERVAL_MS=60000

# ── Zone Cache ──────────────────────────────────────────────
# ZONE_CACHE_TTL_MS=30000
