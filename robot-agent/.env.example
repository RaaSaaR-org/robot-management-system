# ──────────────────────────────────────────────────────────────
# NeoDEM Robot Agent — Environment Variables
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────

# ── LLM Provider ────────────────────────────────────────────
# Provider: "gemini" (default), "openrouter" or "ollama" (local GPU)
# LLM_PROVIDER=gemini

# Gemini (default provider)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter (alternative — free tier available at $0 cost)
# OPENROUTER_API_KEY=your_openrouter_key_here

# Ollama (local — no API key needed; install from https://ollama.com and
# pull the model first, e.g. `ollama pull gpt-oss:20b`)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Override default model (optional)
# Gemini default: gemini-2.5-flash
# OpenRouter default: stepfun/step-3.5-flash:free
# Ollama default: gpt-oss:20b
# LLM_MODEL=

# ── Server Configuration ───────────────────────────────────
PORT=41243
SERVER_URL=http://localhost:3001
PUBLIC_URL=http://localhost:41243

# ── Robot Identity ──────────────────────────────────────────
ROBOT_ID=sim-robot-001
ROBOT_NAME=SimBot-01
ROBOT_MODEL=SimBot H1
# ROBOT_TYPE=generic

# ── Robot Physical Characteristics ──────────────────────────
# Options: lightweight, standard, heavy-duty
ROBOT_CLASS=standard
# Maximum payload capacity in kilograms
MAX_PAYLOAD_KG=10
# Robot description for AI context
ROBOT_DESCRIPTION=A versatile humanoid robot for general tasks

# ── Initial Position ────────────────────────────────────────
INITIAL_X=10.0
INITIAL_Y=10.0
INITIAL_ZONE=Warehouse A
INITIAL_FLOOR=1

# ── Hardware Sidecar (SO-101) ───────────────────────────────
# URL of the LeRobot hardware sidecar (real servo/camera control)
# HARDWARE_SIDECAR_URL=http://localhost:8765

# ── VLA Inference ───────────────────────────────────────────
# Enable VLA inference pipeline
# VLA_ENABLED=false
# VLA_SERVER_URL=http://localhost:8000

# gRPC connection (alternative to REST)
# VLA_INFERENCE_HOST=localhost
# VLA_INFERENCE_PORT=50051

# REST fallback
# VLA_REST_FALLBACK_URL=http://localhost:8000

# VLA tuning
# VLA_TIMEOUT_MS=30000
# VLA_CONNECTION_POOL_SIZE=2
# VLA_HEALTH_CHECK_INTERVAL_MS=30000
# VLA_ROBOT_PORT=41243

# ── Federated Learning ─────────────────────────────────────
# FEDERATED_ENABLED=false
# FEDERATED_BRIDGE_PORT=41244
# FEDERATED_POLL_INTERVAL_MS=60000

# ── Zone Cache ──────────────────────────────────────────────
# ZONE_CACHE_TTL_MS=30000

# ── Agent Mode: occupancy map (TASK-206) ──────────────────────
# The robot's own 2D map, built from the same LiDAR clouds Agent Mode already
# snapshots for range sensing (AGENT_RANGE_*), in the ODOMETRY frame. Nothing
# extra is polled: every fresh cloud is folded into the grid as it arrives.
# Default: on whenever AGENT_RANGE_ENABLED is on. Off means clouds are used once
# per observation and thrown away, exactly as before.
# AGENT_MAP_ENABLED=true
# Cell edge in metres.
# AGENT_MAP_RESOLUTION_M=0.1
# The grid starts 20 m square around the first pose and doubles as needed, up to
# this side length; returns beyond it are dropped, never wrapped.
# AGENT_MAP_MAX_M=60
# Persisted on every 50th integration and at shutdown. Restored on boot ONLY if
# the sidecar/sim reports the same boot_id on /health — a sidecar restart
# re-zeroes odometry and a stale map would be wrong by metres.
# AGENT_MAP_PATH=./data/occupancy-map.json
# Extra snapshots per second while a walk/turn/goto block is running, so the map
# fills in between observations. Reuses the range sensor's cache and failure
# backoff, so a slow sidecar is never hammered. 0 = off; 0.5 is a good sim value.
# AGENT_MAP_SWEEP_HZ=0
# Seconds after which a cell that has not been re-observed drifts back toward
# unknown. 0 = never (static rooms). Turn on for spaces with moving obstacles.
# AGENT_MAP_DECAY_S=0
# How often to ask the server where the OTHER robots are (TASK-207). Peers are
# drawn on this robot's map and block traversability as discs; a peer whose
# odometry frame differs from ours is dropped and counted, never drawn. 0 = off.
# AGENT_PEERS_POLL_MS=2000
# A peer this close and ahead of the robot appears in scene memory as
# "robot <name>" (distanceSource 'fleet'), so the planner can talk about it.
# AGENT_PEERS_NOTICE_M=3
# How `goto` gets there (TASK-208). `grid` plans a path on the occupancy map —
# around walls, other robots and keepout zones (at PLACE_KEEPOUT_MARGIN_M) —
# walks it in segments of at most AGENT_NAV_MAX_SEGMENT_M, looks (VLM + lidar)
# every AGENT_NAV_LOOK_EVERY_M instead of after every metre, and refuses a
# target no stand-off spot around which is outside a keepout. Falls back to
# `staged` (turn, walk ≤1 m, look, repeat) whenever no path is known. Default
# follows AGENT_MAP_ENABLED. Unknown cells cost AGENT_NAV_UNKNOWN_COST × a
# known one — preferred less, still usable.
# AGENT_NAV_PLANNER=grid
# AGENT_NAV_UNKNOWN_COST=3
# AGENT_NAV_MAX_SEGMENT_M=2
# AGENT_NAV_LOOK_EVERY_M=2
