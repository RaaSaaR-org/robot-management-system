# ──────────────────────────────────────────────────────────────
# NeoDEM Robot Agent — Unitree G1 EDU + Dex3-1 (SIMULATION)
# Robot-less profile of .env.g1-edu: same embodiment (43 DOF), but no
# hardware sidecar — HardwareClient stays unavailable so the skill
# executor runs in sim mode. Start via: npm run dev:g1-edu-sim
# ──────────────────────────────────────────────────────────────

# ── LLM Provider ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Server Configuration ───────────────────────────────────
# Ports in use on this box: 41243 SimBot-01, 41244 the REAL G1 EDU 4
# (.env.g1-edu), 41246 the Agent-Mode profile (.env.g1-edu-agent).
PORT=41245
SERVER_URL=http://localhost:3001
PUBLIC_URL=http://localhost:41245

# ── Robot Identity ──────────────────────────────────────────
# A SEPARATE identity from the real G1 EDU 4 (.env.g1-edu, id g1-edu-4), and
# that separation is load-bearing rather than cosmetic (TASK-197): everything
# durable on this agent is keyed by ROBOT_ID — `data/state-<robotId>.json`,
# `data/incarnations-<robotId>.jsonl` and now
# `data/workspace-<robotId>/`, the robot's own memory. Sharing the id made the
# sim and the real robot share one memory, so a place note written while
# driving a simulation would be read back as fact by the physical humanoid.
#
# The cost is that the server's Robot row for `g1-edu-4` no longer resolves to
# this agent: register `g1-edu-4-sim` (a2aAgentUrl http://localhost:41245) as
# its own robot, which is also the honest fleet view — a simulation is not the
# robot it imitates.
ROBOT_ID=g1-edu-4-sim
ROBOT_NAME=Unitree G1 EDU 4 (Sim)
ROBOT_MODEL=Unitree G1 EDU (29 DoF + Dex3-1)
ROBOT_TYPE=g1_edu

# ── Robot Physical Characteristics ──────────────────────────
ROBOT_CLASS=standard
MAX_PAYLOAD_KG=3
ROBOT_DESCRIPTION=Simulated Unitree G1 EDU humanoid (43 DOF incl. Dex3-1 hands) for robot-less platform testing

# ── Initial Position ────────────────────────────────────────
INITIAL_X=2.0
INITIAL_Y=2.0
INITIAL_ZONE=Lab
INITIAL_FLOOR=1

# ── Hardware Sidecar ─────────────────────────────────────────
# Intentionally NOT set — sim mode.

# ── VLA Inference ───────────────────────────────────────────
VLA_ENABLED=true
VLA_REST_FALLBACK_URL=http://localhost:8000
