# ──────────────────────────────────────────────────────────────
# NeoDEM Robot Agent — Unitree G1 EDU + Dex3-1 (SIMULATION)
# Robot-less profile of .env.g1-edu: same embodiment (43 DOF), but no
# hardware sidecar — HardwareClient stays unavailable so the skill
# executor runs in sim mode. Start via: npm run dev:g1-edu-sim
# ──────────────────────────────────────────────────────────────

# ── LLM Provider ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Server Configuration ───────────────────────────────────
# Ports in use on this box: 41243 SimBot-01, 41244 the REAL G1 EDU 4
# (.env.g1-edu), 41246 the Agent-Mode profile (.env.g1-edu-agent).
PORT=41245
SERVER_URL=http://localhost:3001
PUBLIC_URL=http://localhost:41245

# ── Robot Identity ──────────────────────────────────────────
# A SEPARATE identity from the real G1 EDU 4 (.env.g1-edu, id g1-edu-4), and
# that separation is load-bearing rather than cosmetic (TASK-197): everything
# durable on this agent is keyed by ROBOT_ID — `data/state-<robotId>.json`,
# `data/incarnations-<robotId>.jsonl` and now
# `data/workspace-<robotId>/`, the robot's own memory. Sharing the id made the
# sim and the real robot share one memory, so a place note written while
# driving a simulation would be read back as fact by the physical humanoid.
#
# The cost is that the server's Robot row for `g1-edu-4` no longer resolves to
# this agent: register `g1-edu-4-sim` (a2aAgentUrl http://localhost:41245) as
# its own robot, which is also the honest fleet view — a simulation is not the
# robot it imitates.
ROBOT_ID=g1-edu-4-sim
ROBOT_NAME=Unitree G1 EDU 4 (Sim)
ROBOT_MODEL=Unitree G1 EDU (29 DoF + Dex3-1)
ROBOT_TYPE=g1_edu

# ── Robot Physical Characteristics ──────────────────────────
ROBOT_CLASS=standard
MAX_PAYLOAD_KG=3
ROBOT_DESCRIPTION=Simulated Unitree G1 EDU humanoid (43 DOF incl. Dex3-1 hands) for robot-less platform testing

# ── Initial Position ────────────────────────────────────────
INITIAL_X=2.0
INITIAL_Y=2.0
INITIAL_ZONE=Lab
INITIAL_FLOOR=1

# ── Hardware Sidecar ─────────────────────────────────────────
# Intentionally NOT set — sim mode.

# ── VLA Inference ───────────────────────────────────────────
VLA_ENABLED=true
VLA_REST_FALLBACK_URL=http://localhost:8000

# Rollout control-loop period in ms — the sleep between action sends. 200 ms
# (5 Hz) is the historical default; GR00T-N1.7 closed-loop control on the G1
# wants ~15 Hz, which is 67 ms. Must be in (0, 5000]; anything else is ignored
# at boot with a warning. Every RTC figure below is a 5 Hz figure — the
# crossfade reach and the prefetch break-even are both functions of this
# period, and neither has been re-measured at any other rate.
VLA_LOOP_PERIOD_MS=200

# ── Real-Time Chunking (RTC, TASK-183) ──────────────────────
# Off by default, here and everywhere. With it off the rollout loop is serial —
# it drains the action queue, then blocks on /predict for the next chunk, and
# the robot receives nothing for the whole round-trip. With it on the next chunk
# is requested while the current one is still executing and the two are
# crossfaded across the boundary, so the stall goes away.
# Worth turning on for GR00T-style short chunks (8 steps), where a boundary
# comes around often enough that the stall dominates.
VLA_RTC_ENABLED=false
# Fraction of a chunk still queued that triggers the prefetch: 0.25 fires the
# next /predict once three quarters of the chunk has been consumed. Must be in
# (0, 1] — 0 would never fire and >1 would fire before the chunk arrived, so
# either is ignored at boot with a warning and 0.25 is used instead.
VLA_RTC_OVERLAP=0.25
# Steps of crossfade at the boundary. The prefetched chunk was predicted from an
# observation a few steps stale, so its first actions overlap the tail of the
# current one; this is how many steps that overlap is faded over. 0 is legal and
# means prefetch but hard-splice — the A/B control for the blend itself.
VLA_RTC_BLEND_STEPS=5
#
# Two limits, before you turn this on (TASK-183). Both are properties of the
# code, checked in `skill-executor.test.ts` against a MOCKED vla-server at the
# fixed 200 ms (5 Hz) loop period — neither was measured on a robot:
#
#   RTC declines when it would lose. A merged chunk is SHORTER than the one the
#   backend sent — the actions covering the timesteps that elapsed during
#   inference are dropped — so prefetching buys shorter waits at the price of
#   more of them. At chunk 8 and this overlap the prefetch stops paying at
#   1.2 s of /predict — that cut-off is arithmetic, not a rollout result — so
#   the loop measures the round trip and falls back to the plain serial refill
#   past it instead of degrading. Boundaries it declined are
#   counted as `prefetchSkipped` in the run's `rtc` block; a run that is all
#   skips is RTC telling you the server is too slow for it to help.
#
#   The crossfade reaches chunk_size x VLA_RTC_OVERLAP x 200 ms of latency and
#   no further — 400 ms at the defaults here. Past that the chunk lands into an
#   already-empty queue with nothing left to fade against, so the boundary is
#   still free but it is a hard splice. Widen it by raising VLA_RTC_OVERLAP, at
#   the cost of more /predict calls per step. VLA_RTC_BLEND_STEPS is an upper
#   bound on the fade, not a promise of one.
#
#   On real hardware, RTC never gives the sidecar a second caller. The
#   prefetch's OBSERVATION is captured on the loop's own thread, so the only
#   thing overlapped with execution is the /predict to vla-server; the loop
#   still issues at most one sidecar request at a time, in its own order, and
#   the capture is paid out of that step's sleep rather than on top of it --
#   though only while it FITS in the period: the subtraction clamps at zero, so
#   a capture slower than the 200 ms loop period stretches that one step by the
#   overrun and the agent logs a warning naming it. Not measured on a robot.
#   That is deliberate: g1_sidecar.py serialises DDS on a single lock and its
#   /action ramp is only physically correct at a steady cadence, and under the
#   `sentry` rollout strategy the SO-101 sidecar is re-opening the cameras and
#   the follower serial port on demand.
#
#   NOT VALIDATED ON A REAL ROBOT. The sidecar behaviour above is covered by
#   tests against a mocked sidecar (skill-executor.test.ts, "RTC never gives
#   the sidecar a second caller"). No number in this file was measured on a
#   G1 or an SO-101. Turn RTC on for a hardware rollout only with the usual
#   stage-4 precautions, and read `prefetchSkipped`/`stalledTransitions` off
#   the run's `rtc` block afterwards.
