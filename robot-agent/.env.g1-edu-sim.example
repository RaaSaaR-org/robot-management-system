# ──────────────────────────────────────────────────────────────
# NeoDEM Robot Agent — Unitree G1 EDU + Dex3-1 (SIMULATION)
# Robot-less profile of .env.g1-edu: same embodiment (43 DOF), but no
# hardware sidecar — HardwareClient stays unavailable so the skill
# executor runs in sim mode. Start via: npm run dev:g1-edu-sim
# ──────────────────────────────────────────────────────────────

# ── LLM Provider ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Server Configuration ───────────────────────────────────
# Port 41244: the sim agent (SimBot-01) already occupies 41243
PORT=41244
SERVER_URL=http://localhost:3001
PUBLIC_URL=http://localhost:41244

# ── Robot Identity ──────────────────────────────────────────
# Same robot identity as the real G1 EDU 4 (.env.g1-edu): this sim agent is
# the digital stand-in for that robot while the hardware is disconnected —
# the server's existing Robot row (id g1-edu-4, a2aAgentUrl :41244) then
# resolves telemetry/safety/VLA against this agent instead of 404ing.
ROBOT_ID=g1-edu-4
ROBOT_NAME=Unitree G1 EDU 4 (Sim)
ROBOT_MODEL=Unitree G1 EDU (29 DoF + Dex3-1)
ROBOT_TYPE=g1_edu

# ── Robot Physical Characteristics ──────────────────────────
ROBOT_CLASS=standard
MAX_PAYLOAD_KG=3
ROBOT_DESCRIPTION=Simulated Unitree G1 EDU humanoid (43 DOF incl. Dex3-1 hands) for robot-less platform testing

# ── Initial Position ────────────────────────────────────────
INITIAL_X=2.0
INITIAL_Y=2.0
INITIAL_ZONE=Lab
INITIAL_FLOOR=1

# ── Hardware Sidecar ─────────────────────────────────────────
# Intentionally NOT set — sim mode.

# ── VLA Inference ───────────────────────────────────────────
VLA_ENABLED=true
VLA_REST_FALLBACK_URL=http://localhost:8000
