# ──────────────────────────────────────────────────────────────
# NeoDEM Robot Agent — Unitree G1 EDU + Dex3-1, AGENT MODE (TASK-194)
#
# A local Ollama model turns plain-language commands into blocks and drives
# them through LocoClient. This profile talks to the MuJoCo room scene in
# robot-agent/hardware/sim_g1_dds, which speaks the same DDS wire protocol as
# the real robot — so the call path here is the one the G1 EDU gets.
#
#   cp .env.g1-edu-agent.example .env.g1-edu-agent
#   npm run dev:g1-edu-agent
#
# Start the sim first (see hardware/sim_g1_dds/README.md):
#   python sim_node.py --domain 1 --http-port 8777
# ──────────────────────────────────────────────────────────────

# ── Server Configuration ───────────────────────────────────
# 41246: 41243 (SimBot), 41244 (g1-edu-sim) and 41245 (g1-edu) are taken.
PORT=41246
SERVER_URL=http://localhost:3001
PUBLIC_URL=http://localhost:41246

# ── Robot Identity ──────────────────────────────────────────
ROBOT_ID=sim-robot-g1-edu
ROBOT_NAME=G1-EDU-Bot (Agent Mode)
ROBOT_MODEL=Unitree G1 EDU (Dex3-1)
ROBOT_TYPE=g1_edu

# ── Robot Physical Characteristics ──────────────────────────
ROBOT_CLASS=standard
MAX_PAYLOAD_KG=5
ROBOT_DESCRIPTION=Unitree G1 EDU humanoid (43 DOF incl. Dex3-1) driven by a local LLM in Agent Mode

# ── Initial Position ────────────────────────────────────────
INITIAL_X=0.0
INITIAL_Y=0.0
INITIAL_ZONE=Lab
INITIAL_FLOOR=1

# ── Hardware Sidecar ─────────────────────────────────────────
# The sim node's HTTP face. Agent Mode needs this: /loco/*, /state and the
# head-camera snapshots all come through it. Point it at g1_sidecar.py on the
# real robot instead and nothing else in this file changes.
HARDWARE_SIDECAR_URL=http://localhost:8777

# ── Agent Mode ──────────────────────────────────────────────
# Off by default everywhere else. `npm run dev:g1-edu-agent` also forces this
# on, so the profile cannot silently boot with the feature disabled.
AGENT_MODE_ENABLED=true

# Two roles, deliberately separate: the planner never sees pixels, only the
# vision model's text. The code default for both is gemma3:4b, but this profile
# pins gemma4:e2b (`ollama pull gemma4:e2b`) because gemma3:4b measurably cannot
# plan the simplest command in the vocabulary:
#
#   "dreh dich nach links", 5 live runs, gemma3:4b -> 2 OK / 3 honest fallback.
#   It answers {"kind":"turn","reasoning":"..."} with NO angleDeg, then appends
#   a sideways walk nobody asked for. Both attempts fail, so the operator gets
#   "I could not plan that" for a plain turn.
#   Same 5 runs, gemma4:e2b -> 5/5, every turn +90° left, odometry 90.0 / 180.0
#   / 270.0 / 360.0 / 90.0. Also correct on "nach rechts" (-90), "einen Meter
#   vorwaerts" (measured 0.98 m) and "winke mal".
#
# DO NOT use a gemma4 build for vision. On Ollama 0.32.3 its vision path is
# broken: asked for the single colour filling a solid-colour JPEG, at
# temperature 0, gemma4:e2b answers Red / White / White and gemma4:latest
# White / Black / Charcoal. An image is worth only ~110 prompt tokens to it
# (qwen2.5vl spends ~1000 on the same JPEG), so the encoder is degenerate, not
# the transport — verified with a logging proxy in front of Ollama: the request
# Genkit builds does carry the image as a data URL. On the room scene gemma4
# invented "a grid of empty rectangular data fields", which is the JSON skeleton
# in VISION_PROMPT, not the frame.
#
# qwen2.5vl:7b (`ollama pull qwen2.5vl:7b`, ~6 GB) gets 3/3 on the colour test
# and reads the real scene: "hat", "table", "robotic hands" from the head camera,
# and a `scan_room 8` that returns table, chair, hat, ladder, wall, floor, door.
# It also reports a "person", which is correct — the room scene contains a
# person figure at (-1.90, -1.45). Still treat personVisible as a hint and never
# as a safety input: it is one 7B model's opinion of one frame.
AGENT_PLANNER_MODEL=gemma4:e2b
AGENT_VISION_MODEL=qwen2.5vl:7b

# gemma4:e2b thinks before answering, and Ollama has that ON by default. It costs
# roughly 10 s and ~500 generated tokens per call — on a `scan_room 8` that is a
# minute of pure thinking. These two flags turn it off per role; the defaults
# below match the code defaults and were measured, not guessed:
#
#   Planner OFF. 3 of 7 commands lose a little rule adherence ("turn left" gains
#   an invented `walk 0.5 m`, "wave with your left hand" drops the block that
#   says the wave is right-arm only), but nothing steers the robot somewhere it
#   was not sent, and schema validation plus the repair attempt catch the rest.
#   Set to true if you would rather have the plan quality than the ~10 s.
#
#   Vision ON. With thinking off the model put 5 bearings outside the ±60° fan
#   the prompt allows across 3 of 4 real sim frames (chair at 120°, door at 180°)
#   against 1 of 4 with thinking on. Those get clamped to ±90 and stored as
#   confident headings, and bearings are already this pipeline's weak point.
#   Set to false only when you are not navigating by what the camera reports.
#   Both bearing numbers above were measured on gemma4:e2b. qwen2.5vl:7b has no
#   thinking mode, so with the vision model above this flag is inert — it is left
#   on so that switching the vision model back to a thinking one keeps the
#   measured-better setting.
AGENT_PLANNER_THINKING=false
AGENT_VISION_THINKING=true
# How long a whole planning round may take before the plan gives up and the
# robot says so, in ms. ONE budget for the planner's two attempts, not one per
# call — a model that does not answer must not cost twice the number you set.
#
# The default is 300 s, and both bounds are measured rather than guessed. A
# legitimate plan took 3.5 minutes once on a small model, so a shorter deadline
# would fail work that was going to succeed. And on 2026-08-02 this box had the
# opposite: Ollama kept advertising gemma4:e2b as loaded (size_vram=1.77GB)
# after its llama-server worker had died, every request hung, and two commands
# sat in "Planning" for the full 240 s the harness allowed. Without a deadline
# those two states look identical from the console — forever. Restarting the
# Ollama server fixed it; the planner then answered in 1.1 s.
#
# Lower it if you run a fast model and want a wedged one reported sooner.
AGENT_PLANNER_TIMEOUT_MS=300000
# NOTE THE /v1. Genkit talks to Ollama through its OpenAI-compatible API, which
# lives under /v1 — point this at the bare :11434 and every call comes back
# "404 page not found", which the planner correctly reports as "no plan" rather
# than a connection error, so the cause is not obvious from the UI.
AGENT_OLLAMA_BASE_URL=http://localhost:11434/v1

# Camera used by `look` and `scan_room` (must exist in /cameras).
AGENT_CAMERA_NAME=head_camera

# Horizontal FOV of that camera, in degrees. The vision model reports WHERE in
# the frame it saw something; this number turns that into a bearing, so getting
# it wrong scales every bearing and `goto` walks off at an angle.
#   sim head_camera: MJCF fovy 89 at 640x480 -> 2*atan(tan(89/2)*4/3) = 105.3
#   real G1 D435i:   69 for the RGB stream, 87 for depth
# Measured on the room scene, whose landmark positions are exact, over four
# robot poses: asking the model for the angle directly gives 131° mean absolute
# error (it answers ±180 or ±60 and does no projection at all); asking for the
# image position and doing this conversion gives 7.2°.
AGENT_CAMERA_HFOV_DEG=105.3

# ── Range sensing (LiDAR) ───────────────────────────────────
# The camera gives Agent Mode a good bearing (7.2° MAE above) and no usable
# distance: asked for metres, qwen2.5vl:7b answers null most of the time and is
# 0.94 m mean absolute error when it does answer. Without a range measurement
# `goto` only "arrives" by walking into things and noticing it stopped moving.
# These five settings turn the head LiDAR into that measurement.
#
# On. Set to false to go back to the bearing-only behaviour — everything keeps
# working, distances are then labelled as vision guesses and never trigger
# arrival. Missing sidecar, dead publisher or empty cloud degrade the same way
# on their own; this flag is for turning the sensor off deliberately.
AGENT_RANGE_ENABLED=true

# Sensor name asked of the sidecar. `mid360_lidar` is what hardware/g1_sidecar.py
# publishes the real Livox MID-360 as (DDS rt/utlidar/cloud_livox_mid360, domain
# 0, proven live 2026-07-18) AND what hardware/sim_g1_dds/sim_node.py ray-casts
# under the same HTTP contract, so the same value works for robot and sim.
AGENT_RANGE_SENSOR=mid360_lidar

# Returns beyond this are ignored. A surface 15 m away says nothing about the
# stage the robot is about to walk, and including it only invites the planner to
# treat a far wall as the target.
AGENT_RANGE_MAX_M=12

# Half-width of the cone searched around an entity's bearing. Sized to the VLM's
# own 7.2° bearing error: a narrower cone would routinely miss the object it is
# aimed at and report "nothing there" — which the robot must then read as
# UNKNOWN, not as clear.
AGENT_RANGE_CONE_DEG=8

# Returns nearer than this are discarded. About half of every raw MID-360 frame
# is the sensor seeing its own housing at < 0.3 m, so without this floor a naive
# nearest-return answers ~0 m for every direction. It also bounds how close the
# navigator's stopping margin can honestly be: inside this radius the sensor is
# blind by construction.
AGENT_RANGE_MIN_M=0.35

# ── Occupancy map (TASK-206) ─────────────────────────────────
# The robot's own 2D map, folded from the same MID-360 clouds the range settings
# above snapshot — no extra polling — in the ODOMETRY frame. Read it at
# GET /api/v1/robots/:id/map; a summary rides along in the mirrored Agent Mode
# state. Default follows AGENT_RANGE_ENABLED.
AGENT_MAP_ENABLED=true
AGENT_MAP_RESOLUTION_M=0.1
AGENT_MAP_MAX_M=60
# Restored on boot only when the sim/sidecar /health boot_id matches the one
# the map was built under; otherwise starts empty and says why.
AGENT_MAP_PATH=./data/occupancy-map.json
# One extra cloud every 2 s while the robot is walking or turning, so the map
# fills in between looks. The sim answers a snapshot in a few ms; on the real
# G1 keep this ≤ 1 or set 0 and let looks alone feed the map.
AGENT_MAP_SWEEP_HZ=0.5
# 0 = static room, cells never forget. Set e.g. 120 in rooms where things move.
AGENT_MAP_DECAY_S=0
# Other robots on the map (TASK-207): poll cadence in ms (0 = off) and the
# radius inside which a peer ahead of us enters scene memory.
AGENT_PEERS_POLL_MS=2000
AGENT_PEERS_NOTICE_M=3
# `goto` plans on the map (TASK-208): grid | staged. Segments ≤ 2 m, a look
# every 2 m, unknown cells 3× the cost of known floor.
AGENT_NAV_PLANNER=grid
AGENT_NAV_UNKNOWN_COST=3
AGENT_NAV_MAX_SEGMENT_M=2
AGENT_NAV_LOOK_EVERY_M=2
# Extra clearance (m) beyond the footprint radius that planned paths keep from obstacles.
AGENT_NAV_PATH_MARGIN_M=0.05

# `goto` gives up after this many ~1 m stages without closing the distance.
AGENT_MAX_NAV_STAGES=12

# Command → duration conversion. These are the sim's honest speeds; on real
# hardware measure them once and put the measured values here.
AGENT_WALK_SPEED_MPS=0.4
AGENT_TURN_SPEED_DPS=45

# How often the idle watcher looks for a person (ms). Idle never locomotes —
# it only waves/greets, and only for someone who was actually absent before.
AGENT_IDLE_WATCH_INTERVAL_MS=3000

# These bypass the LLM entirely and trigger the E-Stop directly. Keep them
# short and keep them first — a stop word must never wait on a model.
AGENT_STOP_WORDS=stopp,stop,halt

# ── Heartbeat (TASK-199) ────────────────────────────────────
# The robot noticing things while nobody is talking to it: a low battery, a
# base that has been damped for ten minutes, a place estimate that went stale.
# It NEVER moves on its own — the allowed block kinds are look/speak/wait/
# remember, filtered over the plan before it runs.
#
# OFF by default, and opt-in per deployment: this is the pillar with the
# highest blast radius. Turning it on for a robot with no pose source does
# nothing, by design — self-initiated action fails closed on an unknown pose.
AGENT_HEARTBEAT_ENABLED=false

# At most one spoken heartbeat per this many ms, however many predicates fire.
AGENT_HEARTBEAT_MIN_INTERVAL_MS=300000

# Local-time window in which it may speak at all, e.g. `8-20` (`22-6` wraps
# midnight). Empty = always. A value that cannot be read is reported at boot
# and treated as "always" — a typo must not silently switch proactivity off.
AGENT_HEARTBEAT_ACTIVE_HOURS=

# Below this the robot says so. Note it is also the floor `mayInitiate` uses
# for anything that is not `speak`/`wait`: under it the robot reports the
# battery and does nothing else on its own.
AGENT_HEARTBEAT_BATTERY_PCT=20

# Still read by nothing. TASK-200 gave the robot an enforced boundary
# (`zone_violation`), so the reason this could not exist is gone — but a
# heartbeat allowed to WALK also needs its own answer to where it may walk TO,
# and until it has one the allow-list stays look/speak/wait/remember.
AGENT_HEARTBEAT_MOTION=false

# ── VLA Inference ───────────────────────────────────────────
# Agent Mode v1 has no `vla_skill` block; VLA stays off in this profile.
VLA_ENABLED=false

# Real-Time Chunking (TASK-183) is deliberately NOT listed here, unlike in the
# other three profiles — there is no rollout to overlap while the only thing
# driving this agent is Agent Mode. Two things worth knowing anyway:
#
#   VLA_ENABLED gates nothing but the boot banner. The loop RTC touches belongs
#   to POST /robots/:id/skills/execute, which this agent serves regardless; set
#   VLA_RTC_ENABLED here and drive that route by hand and it applies, with the
#   defaults and units documented in .env.example.
#
#   The banner still prints a "Real-Time Chunking: off" line for this profile,
#   for the same reason. It is about that route, not about the line above.

# ── Place awareness (TASK-195) ──────────────────────────────
# A hand-authored place graph gives the robot a vocabulary for WHERE it is
# ("AISLE-3", "DOCK-1"). Unset it and every answer is UNKNOWN — which is the
# honest state for a robot nobody has handed a survey to, not a bug.
# The graph's frame block declares its units and yaw convention and the
# resolver ASSERTS them; a graph in the wrong units fails loudly at boot.
# places.room.json matches sim_g1_dds's default scene (the 6x6 m room with the
# table / chair / shelf / person, furniture as keepouts). places.warehouse.json
# and places.house.json exist for the other layouts.
PLACE_GRAPH_PATH=hardware/sim_evaluator/places/places.room.json

# Accumulated translation (m) after which the place belief degrades to `stale`.
# ~one length of the 20 m warehouse hall: an errand does not spend it, crossing
# the building without a re-anchor does.
PLACE_DRIFT_BUDGET_M=15

# How far inside a polygon the robot must be before a place change commits (m).
# Two consecutive samples this deep are required. Sized to the shared edges in
# the shipped graphs — aisle mouths and dock thresholds are exactly where a
# naive resolver flaps.
PLACE_HYSTERESIS_MARGIN_M=0.30

# DEV ONLY. Forces the cached base pose to null while locomotion keeps working,
# so "Place unknown" can be demonstrated MID-WALK. Killing the sidecar does not
# work for that: it also kills driveFor, so the block fails and you are looking
# at a failed block rather than an honest unknown. Never set on a real robot.
# PLACE_FAULT_NULL_POSE=true

# ── Real sites + the enforced geofence (TASK-200) ───────────
# A REAL site's places come from a DigitalTwin's zones, served by the platform
# at /api/digital-twins/<id>/places/_index.json and cached to disk. Set the twin
# id and LEAVE PLACE_GRAPH_PATH UNSET — an explicit local file always wins, and
# is the sim/bench escape hatch.
#
# The twin id is load-bearing, not a convenience: twins are NOT mutually
# registered (each one's origin is an arbitrary robot pose at scan start), so a
# graph fetched for the wrong twin is expressed about the wrong origin. The
# robot REJECTS a graph whose frame.twinId does not match this value.
# PLACE_TWIN_ID=

# Where the fetched graph is cached. The robot BOOTS FROM THIS FILE and
# refreshes in the background: the platform being down must be a stale map, not
# no map, and must never stall a block.
PLACE_GRAPH_CACHE_PATH=./data/place-graph-cache.json

# How far OUTSIDE a keepout polygon still counts as a violation (m). This is the
# geofence that finally implements SafetyStopType 'zone_violation'. Sized to the
# robot, not the map: the G1's footprint is ~0.4 m and a walking biped needs a
# fraction of a step to stop, so fencing the polygon exactly would fire the stop
# when the robot is already IN the rack. A known, trusted pose inside this
# margin takes a protective stop; a null or stale pose takes none — and does not
# release one either. 0.25 in the 6x6 m room -- 0.50 would fence off most of
# the floor around the table; use 0.50 for the warehouse graph.
PLACE_KEEPOUT_MARGIN_M=0.25

# ── Personal data on this robot: who may read it, how long it is kept ────────
# MEMORY.md, the place notes, the journal and the standing intents are
# operator-authored text — personal data on a device with no disk encryption.
#
# Shared secret the memory/intent endpoints require from OFF-BOX callers
# (`GET/DELETE /api/v1/robots/:id/memory`, `/memory.md`,
# `/agent-mode/intents`, `GET /agent-mode`, `/identity`). Unset ⇒ those
# endpoints answer LOOPBACK ONLY, and a cross-origin browser request is refused
# either way. The platform server must be given the SAME value under the same
# name, or its GDPR Art. 17 fleet erasure gets 401 from every robot it does not
# share a host with — and so does the Agent Mode state read the console falls
# back to when the server's mirror is cold (it then reports the state as
# UNKNOWN rather than as "off", which is correct but useless to an operator).
# AGENT_MEMORY_TOKEN=

# Service-account API token (`ndsa_…`, TASK-165) the robot authenticates its
# compliance reads with: the `command_execution` retention policy and the
# active legal holds. Both routes sit behind the server's authMiddleware, so
# WITHOUT this the journal falls back to its own 30-day window and no legal
# hold can ever suppress pruning. The failure is reported, not silent — see the
# `retention.error` field on GET /robots/:id/memory.
# NEODEM_SERVICE_TOKEN=
