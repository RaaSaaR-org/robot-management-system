# ──────────────────────────────────────────────────────────────
# NeoDEM Voice Service — Environment Variables
# Load with: uv run python -m voice_service --env-file .env.voice
# All values below are the defaults; uncomment to change.
# ──────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
# VOICE_HTTP_PORT=8768
# Any A2A agent root URL (41244 = g1-edu profiles, 41243 = default agent)
# VOICE_AGENT_URL=http://localhost:41244/
# vad = open mic with VAD gating | ptt = push-to-talk via POST /listen/toggle
# VOICE_MODE=vad

# ── Audio backends ───────────────────────────────────────────
# local = PC mic/speaker | g1 = Unitree G1 (multicast mic / speaker adapter)
# VOICE_INPUT_BACKEND=local
# VOICE_OUTPUT_BACKEND=local
# sounddevice index or name substring (scripts/list_devices.py)
# VOICE_INPUT_DEVICE=
# VOICE_OUTPUT_DEVICE=

# ── STT (faster-whisper) ─────────────────────────────────────
# VOICE_STT_MODEL=large-v3-turbo
# VOICE_STT_DEVICE=cuda
# VOICE_STT_COMPUTE=float16

# ── Languages ────────────────────────────────────────────────
# Allowed auto-detection set + fallback
# VOICE_LANGUAGES=en,de
# VOICE_DEFAULT_LANGUAGE=de
# VOICE_LANGUAGE_MIN_PROB=0.6

# ── TTS (Piper) ──────────────────────────────────────────────
# VOICE_TTS_ENGINE=piper
# VOICE_PIPER_VOICE_DE=de_DE-thorsten-high
# VOICE_PIPER_VOICE_EN=en_US-lessac-high

# ── Wake phrase (software, matched on the transcript) ───────
# Comma-separated; empty = open mic (every utterance is for the robot).
# Matching ignores case/punctuation/spacing ("Hey, G-1!" matches "hey g1").
# Recommended on the real robot: hey g1,hallo g1
# VOICE_WAKE_PHRASES=
# After the robot speaks, follow-ups within this window need no wake phrase
# VOICE_WAKE_WINDOW_S=60

# ── VAD / turn-taking ────────────────────────────────────────
# VOICE_VAD_THRESHOLD=0.5
# VOICE_VAD_MIN_SPEECH_MS=250
# VOICE_VAD_MIN_SILENCE_MS=700
# VOICE_VAD_MAX_UTTERANCE_S=30
# VOICE_VAD_PRE_ROLL_MS=300
# VOICE_HALF_DUPLEX_TAIL_MS=250

# ── Session / A2A ────────────────────────────────────────────
# VOICE_SESSION_TIMEOUT_S=300
# VOICE_A2A_TIMEOUT_S=90
# Speak "one moment, please" if the agent takes longer than this; 0 disables
# VOICE_THINKING_FILLER_S=2.5

# ── Unitree G1 backends ──────────────────────────────────────
# VOICE_G1_MCAST_GROUP=239.168.123.161
# VOICE_G1_MCAST_PORT=5555
# NIC IP on the robot LAN (dz-226: "Ethernet 3")
# VOICE_G1_LOCAL_IP=192.168.123.10
# VOICE_G1_ADAPTER_URL=http://localhost:8766

# ── G1 audio adapter process (adapters/g1_audio_adapter.py) ──
# G1_AUDIO_ADAPTER_PORT=8766
# G1_NET_INTERFACE=Ethernet 3
# G1_AUDIO_MOCK=0
