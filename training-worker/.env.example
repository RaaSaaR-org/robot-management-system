# Server + identity
NEODEM_SERVER_URL=http://192.168.178.76:3001
WORKER_ID=worker-mac-mps-01
POLL_INTERVAL_SEC=5
HEARTBEAT_INTERVAL_SEC=30

# RustFS / S3 (on the Pi)
RUSTFS_ENDPOINT=http://192.168.178.76:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET_DATASETS=training-datasets
RUSTFS_BUCKET_MODELS=model-checkpoints

# Training
TRAINING_DEVICE=mps     # mps (Mac) | cuda (Linux GPU) | cpu
CHECKPOINT_INTERVAL_STEPS=100
HF_CACHE_DIR=~/.cache/neodem-worker

# Phase 1a — use stub trainer (fake training, proves the loop)
# Set to false in Phase 1b to use the real SmolVLA LoRA trainer
TRAINER_STUB=true
