# ============================================================================
# NeoDEM — Docker Compose environment
# Copy to .env and fill in secrets:  cp .env.example .env
# Referenced by docker-compose.yml. See docs/deployment.md.
# ============================================================================

# --- Required ---------------------------------------------------------------
# Postgres password (server connects to the bundled postgres service)
POSTGRES_PASSWORD=change-me-postgres
# JWT signing secret — MUST be at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# --- Auth -------------------------------------------------------------------
# Set to true to bypass auth for local/lab bring-up (NOT for production)
AUTH_DISABLED=true
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost,http://localhost:80,http://app,http://app:80
RATE_LIMIT_DISABLED=false

# --- AI (optional, enables NL command + agent reasoning) --------------------
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- Object storage (RustFS / S3, optional) ---------------------------------
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# --- Compliance log encryption (64 hex chars) -------------------------------
COMPLIANCE_LOG_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Frontend build args (browser-facing URLs) ------------------------------
# Default '/api' assumes the app's nginx proxies to the server. For direct
# access from another machine, set to http://<lab-box-ip>:3001/api and rebuild.
VITE_API_BASE_URL=/api
VITE_WS_URL=
VITE_A2A_SERVER_URL=

# --- Robot agent (simulation defaults) --------------------------------------
ROBOT_ID=sim-robot-001
ROBOT_NAME=SimBot-01
ROBOT_MODEL=SimBot H1
ROBOT_CLASS=standard
MAX_PAYLOAD_KG=10
ROBOT_DESCRIPTION=A versatile humanoid robot for general tasks
INITIAL_X=10.0
INITIAL_Y=10.0
INITIAL_ZONE=Warehouse A
INITIAL_FLOOR=1

# --- Released image version (optional) --------------------------------------
# Pull published images instead of building locally:
#   NEODEM_VERSION=2026.06.21 docker compose up -d
# (requires images for that tag in GHCR; build-images.yml publishes them)
# NEODEM_VERSION=latest
