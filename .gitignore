# Environment variables
.env
.env*
!.env.example
# Per-embodiment example profiles (.env.g1-edu-sim.example, .env.so101.example,
# .env.g1-edu-agent.example, ...). `!.env.example` only un-ignores that one
# literal name, so every profile added since needed a `git add -f` and a new
# one silently stayed invisible. These carry placeholders, never secrets.
!.env*.example

# Database
*.db
*.db-journal
.vscode
# OS specific

# Task files
# tasks.json
# tasks/

/temp
.playwright-mcp
.hive-mind
.claude-flow
.mcp.json

# Robot agent persisted state
robot-agent/data/state*.json
# Boot lineage (TASK-196) — one line per process life, rewritten on every boot
robot-agent/data/incarnations-*.jsonl
# Memory workspace (TASK-197) — the robot's own durable memory, per robot id.
# NOT covered by the `state*.json` rule above, and it must not be: a place note
# from a customer facility is personal data with a GDPR erasure story
# (DELETE /api/v1/robots/:id/memory), and committing it puts it in git forever.
robot-agent/data/workspace-*/

# Playwright
app/e2e/results/
app/e2e/report/
