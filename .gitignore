/*.png
/_sweep/
/training-page.md

scratch

# MuJoCo writes its warning log into the CWD of whatever started the sim node,
# and the e2e check reads it from there. Run output, not source.
robot-agent/hardware/sim_g1_dds/MUJOCO_LOG.TXT
robot-agent/hardware/sim_g1_dds/frames/

# Recorded Agent Mode sim runs (video, stills, odometry logs). Capture output,
# regenerated by scripts/record-sim-run.py — never source.
sim-runs/
