# ──────────────────────────────────────────────────────────────
# NeoDEM Server — Environment Variables
# Copy this file to .env and fill in the values.
# Lines marked [REQUIRED in production] MUST be set before deploying.
# ──────────────────────────────────────────────────────────────

# Database
# Local dev: file:./dev.db (SQLite)
# Production: postgresql://user:pass@host:5432/neodem  [REQUIRED in production]
DATABASE_URL="file:./dev.db"

# Authentication  [REQUIRED in production — generate a strong random secret]
JWT_SECRET=dev-secret-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
AUTH_DISABLED=true

# Google/Gemini API key (for NL command interpretation)
GOOGLE_API_KEY=your-api-key

# CORS — comma-separated allowed origins (defaults to localhost dev ports)
# CORS_ORIGINS=https://app.neodem.io

# Rate Limiting — set to true to disable all rate limits (dev/testing only)
RATE_LIMIT_DISABLED=true

# Training Worker Authentication — shared token for GPU worker callbacks
# Set this in production; workers must send Authorization: Bearer <token>
# WORKER_API_TOKEN=

# NATS JetStream (optional — training/synthetic features disabled without it)
NATS_SERVERS=nats://localhost:4222
NATS_USER=
NATS_PASS=

# RustFS Object Storage (S3-compatible, optional)
# Default credentials: rustfsadmin / rustfsadmin
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# GPU Configuration (used by TrainingOrchestrator)
GPU_TOTAL_COUNT=1
GPU_TYPE=unknown
GPU_MEMORY_GB=0

# MLflow Model Registry (optional)
MLFLOW_TRACKING_URI=http://localhost:5000

# Orchestrator LLM (optional — enables intelligent agent routing via OpenRouter)
# Without this key, orchestrator falls back to keyword-based matching
# OPENROUTER_API_KEY=sk-or-v1-...
# ORCHESTRATOR_MODEL=stepfun/step-3.5-flash:free
