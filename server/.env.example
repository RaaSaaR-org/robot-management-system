# Database
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET=dev-secret-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
AUTH_DISABLED=true
GOOGLE_API_KEY=your-api-key

# NATS JetStream
NATS_SERVERS=nats://localhost:4222
NATS_USER=
NATS_PASS=

# RustFS Object Storage (S3-compatible)
# Default credentials: rustfsadmin / rustfsadmin
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# MLflow Model Registry
MLFLOW_TRACKING_URI=http://localhost:5000

# Orchestrator LLM (optional — enables intelligent agent routing via OpenRouter)
# Without this key, orchestrator falls back to keyword-based matching
# OPENROUTER_API_KEY=sk-or-v1-...
# ORCHESTRATOR_MODEL=stepfun/step-3.5-flash:free
