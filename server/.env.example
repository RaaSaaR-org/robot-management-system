# ──────────────────────────────────────────────────────────────
# NeoDEM Server — Environment Variables
# Copy this file to .env and fill in the values.
# Lines marked [REQUIRED in production] MUST be set before deploying.
# ──────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────
PORT=3001
# Public URL for agent discovery (set to your public domain in production)
# PUBLIC_URL=https://neodem.yourdomain.com

# ── Database ────────────────────────────────────────────────
# Local dev: file:./dev.db (SQLite)
# Production: postgresql://user:pass@host:5432/neodem  [REQUIRED in production]
DATABASE_URL="file:./dev.db"

# ── Authentication ──────────────────────────────────────────
# [REQUIRED in production — generate with: openssl rand -base64 48]
JWT_SECRET=dev-secret-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
AUTH_DISABLED=true

# ── CORS ────────────────────────────────────────────────────
# Comma-separated allowed origins (defaults to localhost dev ports)
# CORS_ORIGINS=https://app.neodem.io

# ── Rate Limiting ───────────────────────────────────────────
# Set to true to disable all rate limits (dev/testing only)
RATE_LIMIT_DISABLED=true

# ── AI / LLM ───────────────────────────────────────────────
# Provider for every server-side LLM call: gemini (default) | openrouter | ollama.
# Leave unset to keep the historical per-call-site behaviour — NL command
# interpretation on Gemini, orchestrator routing on OpenRouter — each of which
# activates only when its own key below is set.
# LLM_PROVIDER=ollama

# Google/Gemini API key (for NL command interpretation)
GOOGLE_API_KEY=your-api-key

# Orchestrator LLM (optional — enables intelligent agent routing via OpenRouter)
# Without this key, orchestrator falls back to keyword-based matching
# OPENROUTER_API_KEY=sk-or-v1-...
# ORCHESTRATOR_MODEL=stepfun/step-3.5-flash:free
# Agent-routing LLM budget in ms (default 5000). Raise it for local models,
# which may need to load from disk before answering.
# ORCHESTRATOR_TIMEOUT_MS=5000

# Local Ollama (LLM_PROVIDER=ollama) — no API key needed. Must include /v1.
# Defaults: text qwen3.6, vision qwen3-vl:8b. Pull them first:
#   ollama pull qwen3.6 && ollama pull qwen3-vl:8b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Training Worker ─────────────────────────────────────────
# Worker status comes from heartbeats (in-memory registry on the server,
# exposed via GET /api/training/workers). No GPU env config needed.

# Training Worker Authentication — shared token for worker callbacks
# [REQUIRED in production — generate with: openssl rand -hex 32]
# Workers must send Authorization: Bearer <token>
# WORKER_API_TOKEN=

# Stub NATS training worker (set to true for local testing without NATS)
# TRAINING_NATS_STUB=false

# ── NATS JetStream (optional) ──────────────────────────────
# Training/synthetic features disabled without it
NATS_SERVERS=nats://localhost:4222
NATS_USER=
NATS_PASS=

# ── RustFS Object Storage (S3-compatible, optional) ────────
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
# RUSTFS_REGION=us-east-1
# RUSTFS_BUCKET=training-datasets

# ── VLA Server (optional) ──────────────────────────────────
# VLA_SERVER_URL=http://localhost:8000

# ── Isaac Lab Simulation (optional) ────────────────────────
# ISAAC_LAB_URL=http://localhost:8080
# ISAAC_LAB_ENDPOINT=http://localhost:8080
# ISAAC_LAB_API_KEY=
# ISAAC_LAB_MOCK=false
# SIMULATION_BACKEND=isaac

# ── Dataset Curation (episode trim / delete / AI suggest, TASK-168) ──
# Interpreter for the dependency-light v2.1 backend (needs pyarrow + pandas)
# CURATION_PYTHON=python3
# Interpreter with lerobot >= 0.6 for v3.0 chunked datasets (no default;
# v3 curation requests fail with a clear error when unset)
# CURATION_LEROBOT_PYTHON=/opt/conda/envs/lerobot/bin/python
# Legacy path-mode root for datasets without a DB row (default /tmp/neodem-datasets)
# CURATION_DATASETS_ROOT=/tmp/neodem-datasets
# ffmpeg binary for frame-accurate video re-cuts on trim (default: ffmpeg on PATH)
# CURATION_FFMPEG=/usr/bin/ffmpeg
# Optional VLM pass over curation suggestions. Names the provider family:
# gemini (needs GOOGLE_API_KEY) | ollama (local) | openrouter.
# CURATION_VLM=gemini
# CURATION_VLM_MODEL=gemini-2.5-flash

# ── Compliance ──────────────────────────────────────────────
# 64-char hex key for encrypting compliance/audit logs
# [REQUIRED in production — generate with: openssl rand -hex 32]
# COMPLIANCE_LOG_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Robot agents' personal-data gate ────────────────────────
# The SAME shared secret the robot agents read as AGENT_MEMORY_TOKEN. The agent
# refuses its personal-data routes to off-box callers without it — the GDPR
# Art. 17 fleet memory erasure and the Agent Mode state read this server falls
# back to when its in-memory mirror is cold (GET /api/robots/:id/agent-mode).
# Unset ⇒ the agents answer LOOPBACK ONLY, which is correct for a single box
# and 401s for every robot on another host.
# AGENT_MEMORY_TOKEN=

# ── Patrol (TASK-212) ───────────────────────────────────────
# Cron-driven patrol scheduler: fires enabled PatrolRoutes with a cronExpression
# on their robot (origin 'scheduled', mode 'patrol'), once per slot; retries once
# after PATROL_RETRY_MIN minutes when the robot refused or was unreachable.
PATROL_SCHEDULER_ENABLED=true
PATROL_RETRY_MIN=10
# Where patrol photos live when RustFS is not configured (S3 bucket
# `patrol-photos` when it is). Relative to the server working directory.
PATROL_PHOTO_DIR=./data/patrol-photos
# Retention: plain control photos (hours, default 72), baseline + finding
# photos (days, default 30 = platform retention). Swept hourly.
PATROL_PHOTO_RETENTION_H=72
PATROL_PHOTO_RETENTION_DAYS=30
