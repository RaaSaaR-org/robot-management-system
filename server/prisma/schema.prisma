// ============================================================================
// VLA (VISION-LANGUAGE-ACTION) TRAINING MANAGEMENT
// ============================================================================

// RobotType - Robot embodiment configurations for VLA training
model RobotType {
  id                String   @id @default(uuid())
  name              String   @unique
  manufacturer      String
  model             String
  actionDim         Int // VLA action dimensions
  proprioceptionDim Int // VLA observation dimensions
  cameras           String   @default("[]") // JSON: CameraConfig[]
  capabilities      String   @default("[]") // JSON: Robot capabilities array
  limits            String   @default("{}") // JSON: JointLimits
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  datasets         Dataset[]
  skillDefinitions SkillDefinition[]
  embodiments      Embodiment[]

  @@index([manufacturer])
}

// Embodiment - YAML-based embodiment configurations for VLA pipeline
model Embodiment {
  id                String   @id @default(uuid())
  tag               String   @unique // e.g., 'unitree_h1', 'so101_arm'
  manufacturer      String
  model             String
  description       String?
  configYaml        String // Full YAML configuration content
  actionDim         Int // Action space dimension
  proprioceptionDim Int // Proprioception dimension
  robotTypeId       String? // Optional link to RobotType
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  robotType RobotType? @relation(fields: [robotTypeId], references: [id], onDelete: SetNull)

  @@index([robotTypeId])
  @@index([manufacturer])
  @@index([tag])
}

// SkillDefinition - Learnable robot skills
model SkillDefinition {
  id                   String   @id @default(uuid())
  name                 String
  version              String
  description          String?
  parametersSchema     String   @default("{}") // JSON: Zod-compatible parameter validation (JSON Schema format)
  defaultParameters    String   @default("{}") // JSON: Record<string, unknown>
  preconditions        String   @default("[]") // JSON: Condition[]
  postconditions       String   @default("[]") // JSON: Condition[]
  requiredCapabilities String   @default("[]") // JSON: Array of required robot capabilities
  timeout              Int? // Execution timeout in seconds
  maxRetries           Int      @default(3)
  status               String   @default("draft") // 'draft' | 'published' | 'deprecated' | 'archived'
  linkedModelVersionId String? // Optional link to a trained model version
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  compatibleRobotTypes RobotType[]
  datasets             Dataset[]
  modelVersions        ModelVersion[]
  skillChainSteps      SkillChainStep[]

  @@unique([name, version])
  @@index([status])
  @@index([linkedModelVersionId])
}

// SkillChain - A sequence of skills to be executed together
model SkillChain {
  id                String   @id @default(uuid())
  name              String
  description       String?
  status            String   @default("draft") // 'draft' | 'active' | 'archived'
  estimatedDuration Int? // Total estimated duration in seconds
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  steps SkillChainStep[]

  @@index([status])
  @@index([name])
}

// SkillChainStep - Individual step in a skill chain
model SkillChainStep {
  id              String @id @default(uuid())
  chainId         String
  skillId         String
  order           Int // Order in the chain (0-indexed)
  parameters      String @default("{}") // JSON: Record<string, unknown>
  inputMapping    String @default("{}") // JSON: Record<string, string> - Map previous output to input
  onFailure       String @default("abort") // 'abort' | 'skip' | 'retry'
  maxRetries      Int? // Override skill's default maxRetries
  timeoutOverride Int? // Override skill's default timeout

  // Relations
  chain SkillChain      @relation(fields: [chainId], references: [id], onDelete: Cascade)
  skill SkillDefinition @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([chainId, order])
  @@index([chainId])
  @@index([skillId])
}

// Dataset - Training datasets in LeRobot v3 format
model Dataset {
  id                 String   @id @default(uuid())
  name               String
  description        String?
  robotTypeId        String
  skillId            String?
  storagePath        String // RustFS storage location
  lerobotVersion     String // LeRobot v3 format version
  fps                Int
  totalFrames        Int
  totalDuration      Float // Duration in seconds
  demonstrationCount Int
  qualityScore       Int? // 0-100
  infoJson           String   @default("{}") // JSON: LeRobot metadata
  statsJson          String   @default("{}") // JSON: LeRobot stats
  status             String   @default("uploading") // 'uploading' | 'validating' | 'ready' | 'failed'
  huggingFaceRepoId  String? // HuggingFace repo ID (e.g. "lerobot/svla_so101_pickplace")
  annotationsJson    String   @default("[]") // JSON: EpisodeAnnotation[] from lerobot-annotate jobs (TASK-179)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Multi-tenancy (TASK-155) — nullable so single-tenant mode works without it
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  // Relations
  robotType    RobotType        @relation(fields: [robotTypeId], references: [id])
  skill        SkillDefinition? @relation(fields: [skillId], references: [id])
  trainingJobs TrainingJob[]

  @@index([robotTypeId])
  @@index([skillId])
  @@index([status])
  @@index([huggingFaceRepoId])
  @@index([tenantId, updatedAt])
}

// TrainingJob - Training job queue entries
model TrainingJob {
  id                 String    @id @default(uuid())
  // 'supervised' (VLA fine-tune, the default) | 'sim_rl' (twin-derived RL nav
  // policy, TASK-172.C). sim_rl jobs carry sceneId instead of datasetId.
  kind               String    @default("supervised")
  datasetId          String? // null for sim_rl jobs
  baseModel          String? // 'pi0' | 'pi0_6' | 'openvla' | 'groot' | 'smolvla'; null for sim_rl
  fineTuneMethod     String? // 'lora' | 'full' | 'oft'; null for sim_rl
  sceneId            String? // SimScene the RL policy trains in (sim_rl only)
  twinId             String? // denormalized convenience (source twin of the scene)
  hyperparameters    String    @default("{}") // JSON: { learning_rate, batch_size, epochs, lora_rank, warmup_steps }
  gpuRequirements    String    @default("{}") // JSON: { count, memory, type }
  status             String    @default("pending") // 'pending' | 'queued' | 'running' | 'completed' | 'failed' | 'cancelled'
  progress           Int       @default(0) // 0-100
  currentEpoch       Int?
  totalEpochs        Int?
  metrics            String    @default("{}") // JSON: training/validation loss curves
  mlflowRunId        String?
  mlflowExperimentId String?
  bullmqJobId        String? // BullMQ queue tracking
  startedAt          DateTime?
  completedAt        DateTime?
  errorMessage       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Multi-tenancy (TASK-155) — nullable so single-tenant mode works without it
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  // Relations
  dataset       Dataset?       @relation(fields: [datasetId], references: [id])
  scene         SimScene?      @relation(fields: [sceneId], references: [id])
  modelVersions ModelVersion[]

  @@index([datasetId])
  @@index([status])
  @@index([baseModel])
  @@index([kind])
  @@index([tenantId, updatedAt])
}

// ModelVersion - Trained model artifacts
model ModelVersion {
  id                 String   @id @default(uuid())
  skillId            String? // Optional — models can be linked to a skill later
  trainingJobId      String
  // 'vla' (supervised fine-tune, default) | 'rl_policy' (sim_rl nav policy,
  // TASK-172.C). Drives the sim-only validation gate + the eval runner choice.
  modelType          String   @default("vla")
  version            String // Semantic version string
  artifactUri        String // RustFS model location
  checkpointUri      String? // Intermediate checkpoints location
  trainingMetrics    String   @default("{}") // JSON: training metrics
  validationMetrics  String   @default("{}") // JSON: validation metrics
  deploymentStatus   String   @default("staging") // 'staging' | 'canary' | 'production' | 'archived'
  mlflowModelName    String?
  mlflowModelVersion String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  skill       SkillDefinition? @relation(fields: [skillId], references: [id])
  trainingJob TrainingJob      @relation(fields: [trainingJobId], references: [id])
  deployments Deployment[]

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([skillId, version])
  @@index([deploymentStatus])
  @@index([trainingJobId])
  @@index([tenantId, createdAt])
}

// Deployment - Fleet deployment tracking
model Deployment {
  id                 String    @id @default(uuid())
  modelVersionId     String
  strategy           String // 'canary' | 'blue_green' | 'rolling'
  targetRobotTypes   String    @default("[]") // JSON: Robot types to deploy to
  targetZones        String    @default("[]") // JSON: Zones to deploy to
  trafficPercentage  Int       @default(0) // 0-100
  canaryConfig       String    @default("{}") // JSON: { stages, durations, thresholds }
  rollbackThresholds String    @default("{}") // JSON: { errorRate, latencyP99, failureRate }
  status             String    @default("pending") // 'pending' | 'deploying' | 'canary' | 'production' | 'rolling_back' | 'failed'
  deployedRobotIds   String    @default("[]") // JSON: Robots successfully deployed
  failedRobotIds     String    @default("[]") // JSON: Robots that failed deployment
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  modelVersion ModelVersion @relation(fields: [modelVersionId], references: [id])

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([modelVersionId])
  @@index([status])
  @@index([tenantId, createdAt])
}

// EvaluationEpisode - Track VLA model evaluation rollouts
model EvaluationEpisode {
  id           String   @id @default(uuid())
  robotId      String
  modelVersion String
  taskPrompt   String
  startedAt    DateTime
  endedAt      DateTime
  durationMs   Int
  success      Boolean
  errorType    String?
  videoUrl     String?
  metadata     String   @default("{}") // JSON: Record<string, unknown>
  createdAt    DateTime @default(now())

  robot Robot @relation(fields: [robotId], references: [id], onDelete: Cascade)

  @@index([robotId])
  @@index([modelVersion])
  @@index([createdAt])
  @@index([success])
}

// EpisodeReward - Per-episode reward-model scores + progress curves
// (LeRobot 0.6.0 Robometer/TOPReward, TASK-179)
model EpisodeReward {
  id           String   @id @default(uuid())
  tenantId     String?
  datasetId    String
  episodeIndex Int
  rewardType   String // "robometer" | "topreward"
  score        Float
  success      Boolean?
  curve        String   @default("[]") // JSON number[] (per-frame progress)
  fps          Float?
  jobId        String? // TrainingJob (kind reward_model) that produced the row
  createdAt    DateTime @default(now())

  @@unique([datasetId, episodeIndex, rewardType])
  @@index([datasetId])
}

// InterventionEpisode - DAgger-style human intervention during a rollout
// (LeRobot 0.6.0 rollout strategies, TASK-179)
model InterventionEpisode {
  id         String   @id @default(uuid())
  tenantId   String?
  robotId    String
  skillId    String?
  taskPrompt String
  strategy   String   @default("dagger")
  startedAt  DateTime
  endedAt    DateTime
  stepsJson  String   @default("[]") // JSON: [{t, source: 'human'|'policy', action: number[]}]
  createdAt  DateTime @default(now())

  @@index([robotId])
}

// ============================================================================
// SECURE OTA UPDATES (CRA Art. 13, MR Art. 10)
// ============================================================================

model UpdatePackage {
  id         String    @id @default(cuid())
  version    String
  changelog  String
  signature  String // Base64 Ed25519 signature
  publicKey  String // Base64 public key
  checksum   String // SHA-256 of package
  fileSize   Int       @default(0)
  status     String    @default("pending") // 'pending' | 'approved' | 'deployed' | 'rolled_back'
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  deployments UpdateDeployment[]

  @@index([status])
  @@index([version])
  @@index([createdAt])
}

model UpdateDeployment {
  id              String    @id @default(cuid())
  packageId       String
  robotId         String
  status          String    @default("pending") // 'pending' | 'downloading' | 'installing' | 'success' | 'failed' | 'rolled_back'
  previousVersion String?
  deployedAt      DateTime?
  rolledBackAt    DateTime?
  errorMessage    String?
  createdAt       DateTime  @default(now())

  package UpdatePackage @relation(fields: [packageId], references: [id])

  @@index([packageId])
  @@index([robotId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// DATA CONTRIBUTION MODELS (TASK-065)
// ============================================================================

model DataContribution {
  id            String   @id @default(cuid())
  userId        String
  robotId       String
  episodeCount  Int      @default(0)
  frameCount    Int      @default(0)
  sizeBytes     BigInt   @default(0)
  status        String   @default("pending") // pending | processing | approved | rejected
  creditAwarded Int      @default(0)
  impactScore   Float    @default(0)
  metadata      String? // JSON string
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([robotId])
  @@index([status])
  @@index([createdAt])
}

model ContributionCredit {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ============================================================================
// SKILL & DATA MARKETPLACE (TASK-156)
// ============================================================================
//
// Loose sellerId/buyerId/authorId strings — NO relation to User, matching the
// DataContribution/ContributionCredit convention above.

model MarketplaceListing {
  id               String   @id @default(cuid())
  sellerId         String
  sellerName       String
  type             String // skill | dataset
  title            String
  shortDescription String
  fullDescription  String
  robotType        String // SO-101 | Unitree H1 | Generic
  baseModel        String   @default("None") // SmolVLA | Pi0.5 | OpenVLA | None
  tags             String   @default("[]") // JSON: string[]
  status           String   @default("published") // draft | pending_review | published | suspended
  isFeatured       Boolean  @default(false)
  isTrending       Boolean  @default(false)
  downloadCount    Int      @default(0)
  rating           Float    @default(0) // denormalized avg, updated on review
  reviewCount      Int      @default(0) // denormalized
  taskCategory     String?
  successRate      Float?
  adapterSizeMB    Float?
  episodeCount     Int?
  frameCount       Int?
  datasetSizeGB    Float?
  collectionMethod String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  licenses  ListingLicense[]
  versions  ListingVersion[]
  purchases ListingPurchase[]
  reviews   ListingReview[]

  @@index([sellerId])
  @@index([type])
  @@index([status])
  @@index([robotType])
}

model ListingVersion {
  id             String             @id @default(cuid())
  listingId      String
  listing        MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  version        String             @default("1.0.0")
  artifactUri    String // "local://<relative path>" or "rustfs://<bucket>/<key>"
  fileName       String
  fileSizeBytes  BigInt             @default(0)
  checksumSha256 String?
  changelog      String?
  createdAt      DateTime           @default(now())

  @@index([listingId])
}

model ListingLicense {
  id           String             @id @default(cuid())
  listingId    String
  listing      MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tier         String // research | per_robot | per_fleet | enterprise
  label        String
  description  String
  priceCredits Int
  features     String             @default("[]") // JSON: string[]

  purchases ListingPurchase[]

  @@unique([listingId, tier])
}

model ListingPurchase {
  id            String             @id @default(cuid())
  buyerId       String
  listingId     String
  listing       MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  licenseId     String
  license       ListingLicense     @relation(fields: [licenseId], references: [id])
  versionId     String?
  creditsPaid   Int
  downloadCount Int                @default(0)
  purchasedAt   DateTime           @default(now())

  @@unique([buyerId, listingId])
  @@index([buyerId])
  @@index([listingId])
}

model ListingReview {
  id         String             @id @default(cuid())
  listingId  String
  listing    MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  authorTier String             @default("bronze")
  rating     Int
  body       String
  robotType  String             @default("Generic")
  createdAt  DateTime           @default(now())

  @@unique([listingId, authorId])
  @@index([listingId])
}

// ============================================================================
// VLA SESSION TRACKING (TASK-077)
// ============================================================================

model VlaSession {
  id        String    @id @default(cuid())
  robotId   String
  robot     Robot     @relation(fields: [robotId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now())
  stoppedAt DateTime?
  prompt    String
  serverUrl String
  status    String    @default("running") // "running" | "stopped" | "error"
  errorMsg  String?
  createdAt DateTime  @default(now())

  @@index([robotId])
  @@index([startedAt])
}

// ============================================================================
// PATROL (TASK-212) — routes are the source of record, runs + findings are the
// persisted history of what the robot reported (`agent:patrol:*` /
// `agent:finding:*`). JSON columns are TEXT (SQLite locally); (de)serialised in
// PatrolRepository. tenantId-scoped like Alert.
// ============================================================================

model PatrolRoute {
  id             String    @id @default(uuid())
  name           String
  robotId        String? // robot the route is bound to; null = any robot the operator starts it on
  twinId         String? // DigitalTwin whose place graph the checkpoints reference
  checkpoints    String    @default("[]") // JSON PatrolCheckpoint[]
  cronExpression String? // 5-field cron, server local time; null = manual only
  enabled        Boolean   @default(true)
  timeWindows    String    @default("[]") // JSON PatrolTimeWindow[]
  homePlaceId    String?
  lastFiredAt    DateTime? // scheduler: last slot that fired
  nextRunAt      DateTime? // scheduler: next planned slot (null = not initialised / manual)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([robotId])
  @@index([enabled])
  @@index([createdAt])
}

model PatrolRun {
  id           String    @id // = PatrolRun.runId minted by the robot (or the server for 'unreachable' skips)
  routeId      String // plain column, NO FK: history must survive route deletion and runs the robot reports for routes the server does not know (disk cache, route_unknown)
  routeName    String
  robotId      String
  mode         String // PatrolRunMode: 'baseline' | 'patrol'
  origin       String // PatrolRunOrigin: 'operator' | 'scheduled'
  window       String? // PatrolTimeWindow.id the run matched
  status       String // PatrolRunStatus: running|done|aborted|failed|skipped
  reason       String?
  startedAt    DateTime
  finishedAt   DateTime?
  legs         String    @default("[]") // JSON PatrolLeg[]
  findingCount Int       @default(0)
  planId       String?
  alertId      String? // alert raised for a skipped run (idempotency)
  promotedAt   DateTime? // when an operator promoted this run to the route's baseline (latest wins per route+window)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  findings PatrolFinding[]

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([routeId])
  @@index([robotId])
  @@index([status])
  @@index([startedAt])
  @@index([promotedAt])
  @@index([createdAt])
}

model PatrolFinding {
  id           String   @id // minted by the robot
  runId        String
  routeId      String
  robotId      String
  checkpointId String?
  legIndex     Int      @default(0)
  type         String // PatrolFindingType
  severity     String // PatrolFindingSeverity (server-derived by type × window)
  source       String // PatrolFindingSource
  place        String?
  pose         String? // JSON {x,y,yawDeg}
  at           DateTime
  summary      String
  evidence     String   @default("{}") // JSON PatrolFindingEvidence
  model        String?
  confidence   Float    @default(0)
  status       String   @default("open") // PatrolFindingStatus
  alertId      String?
  incidentId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  run PatrolRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([runId])
  @@index([routeId])
  @@index([robotId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

// ============================================================================
// HOST MODE (TASK-213) — tour routes are the source of record, runs are the
// persisted history of what the robot said and what it was asked
// (`agent:tour:*`). JSON columns are TEXT (SQLite locally); (de)serialised in
// TourRepository. tenantId-scoped like PatrolRoute.
//
// No cron, no time windows, no findings: a tour is triggered by a person the
// robot greets or by an operator, never by a clock, so there is nothing for a
// scheduler to own.
// ============================================================================

model TourRoute {
  id              String   @id @default(uuid())
  name            String
  robotId         String? // robot the route is bound to; null = any robot the operator starts it on
  twinId          String? // DigitalTwin whose place graph the stops reference
  language        String   @default("en") // SpokenLanguage: the tour's default; a visitor who speaks the other one wins per turn
  greetingPlaceId String // where the robot waits for visitors and returns to
  greeting        String // authored welcome; the robot appends the AI disclosure, which no column can remove
  offer           String
  farewell        String
  siteCard        String   @default("[]") // JSON string[] — facts true anywhere on this tour
  stops           String   @default("[]") // JSON TourStop[] (headline, talkTrack, facts, demo, dwellS, askToContinue)
  enabled         Boolean  @default(true)
  autoGreet       Boolean  @default(false) // may the robot offer this tour to a person it sees, unprompted?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([robotId])
  @@index([enabled])
  @@index([createdAt])
}

model TourRun {
  id               String    @id // = TourRun.runId minted by the robot (or by the server when the start never reached it)
  routeId          String // plain column, NO FK: history must survive route deletion and runs the robot reports for routes the server does not know (disk cache)
  routeName        String
  robotId          String
  origin           String // TourRunOrigin: 'visitor' | 'operator'
  status           String // TourRunStatus: running|done|declined|abandoned|aborted|failed|skipped
  reason           String?
  startedAt        DateTime
  finishedAt       DateTime?
  legs             String    @default("[]") // JSON TourLeg[]
  turns            String    @default("[]") // JSON TourTurn[] — question/answer text only; no audio, no identity
  language         String    @default("en") // SpokenLanguage the run was conducted in
  disclosureSpoken Boolean   @default(false) // EU AI Act Art. 50 evidence: recorded per run, never assumed
  planId           String?
  alertId          String? // alert raised for a skipped/failed run (idempotency)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([routeId])
  @@index([robotId])
  @@index([status])
  @@index([startedAt])
  @@index([createdAt])
}

// ============================================================================
// MULTI-TENANCY (TASK-155)
// ============================================================================
//
// Row-level multi-tenancy. Gated behind MULTI_TENANCY_ENABLED feature flag.
// When disabled, all tenantId columns stay NULL and the Prisma client
// extension is a no-op — behaviour is identical to single-tenant mode.
// When enabled, a DEFAULT tenant is seeded and existing rows backfill to it.
// Wave 1 scope: User, Robot, Dataset, TrainingJob. Follow-up waves extend
// the allowlist to the remaining top-level entities.

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique // e.g. "default", "acme", "contoso"
  name      String
  logoUrl   String?
  plan      String? // optional: "free" | "pro" | ...
  settings  String   @default("{}") // JSON: per-tenant feature overrides, branding
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations (Wave 1 pilot models)
  users        User[]
  robots       Robot[]
  datasets     Dataset[]
  trainingJobs TrainingJob[]

  // Relations (Wave 3a — operations visibility)
  alerts        Alert[]
  incidents     Incident[]
  robotTasks    RobotTask[]
  robotCommands RobotCommand[]

  // Relations (Wave 3b — automations & workflows)
  processDefinitions ProcessDefinition[]
  processInstances   ProcessInstance[]
  approvalRequests   ApprovalRequest[]
  events             Event[]

  // Relations (Wave 3c — VLA lifecycle)
  modelVersions  ModelVersion[]
  deployments    Deployment[]
  simulationJobs SimulationJob[]
  syntheticJobs  SyntheticJob[]

  // Relations (Wave 3d — conversations / misc)
  zones         Zone[]
  conversations Conversation[]

  // Relations (Wave 3e — service accounts)
  apiTokens ApiToken[]

  // Relations (TASK-212 patrol)
  patrolRoutes   PatrolRoute[]
  patrolRuns     PatrolRun[]
  patrolFindings PatrolFinding[]

  // Relations (TASK-213 host mode)
  tourRoutes TourRoute[]
  tourRuns   TourRun[]

  @@index([slug])
}
