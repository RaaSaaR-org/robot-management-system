diff --git a/.github/workflows/check.yml b/.github/workflows/check.yml
index 77ec2835..9e5b2f12 100644
--- a/.github/workflows/check.yml
+++ b/.github/workflows/check.yml
@@ -5,6 +5,16 @@ name: Check
 #   - app         typecheck + unit tests + build (default mode)
 #   - app         build with VITE_DEMO_MODE=true (mirrors deploy-demo.yml)
 #   - robot-agent typecheck + unit tests
+#   - python       the four suites test-all.sh runs (sim, curation, hardware
+#                  sidecar, Isaac offline verifiers)
+#   - e2e          the Playwright demo gate
+#
+# The python and e2e jobs exist because those suites gated nothing until
+# 2026-09-06: this file ran neither, and both `scripts/test-all.sh` python
+# stages SKIP rather than fail when their interpreter is absent. That is how
+# ~500 python assertions and a Playwright suite that had been red since the day
+# it was written both went unnoticed for months. A skip is not a pass, so these
+# jobs install the interpreters outright and have no skip path.
 #
 # Unit tests (vitest) run with no external services — they mock Prisma,
 # NATS, sockets, and subprocesses, so no postgres/nats/rustfs containers
@@ -204,3 +214,73 @@ jobs:
               echo "::error::prisma/migrations drifts from schema.prisma. A model was likely applied via 'db push' without a migration. Generate a catch-up migration (see prisma/migrations/20260701120000_catch_up_db_push_column_drift)."
               exit 1
             }
+
+  python:
+    name: Python suites (sim, curation, sidecar, Isaac verifiers)
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+
+      # One interpreter for all four stages. `test-all.sh` lets each of them
+      # fall back to whichever venv exists, so a single environment that
+      # satisfies the union is exactly what it expects to find.
+      #   * curation  -> requirements.txt (pyarrow, pandas, ffmpeg round-trip)
+      #   * sim       -> mujoco + numpy + pytest
+      #   * sidecar   -> numpy + pytest, plus httpx and pyzmq so the SmolVLA and
+      #                  teleimager cases RUN instead of skipping themselves
+      #   * verifiers -> stdlib only
+      - name: Install python deps
+        run: |
+          python -m pip install --upgrade pip
+          python -m pip install -r server/curation/requirements.txt
+          python -m pip install mujoco pytest numpy httpx pyzmq
+
+      - name: Install ffmpeg (curation round-trip test)
+        run: sudo apt-get update && sudo apt-get install -y ffmpeg
+
+      - name: Run the python stages
+        env:
+          SIM_PYTHON: python
+          CURATION_PYTHON: python
+          HARDWARE_PYTHON: python
+        run: ./scripts/test-all.sh --python-only
+
+  e2e:
+    name: Playwright (demo gate)
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '20'
+          cache: 'npm'
+          cache-dependency-path: app/package-lock.json
+
+      - name: Install
+        working-directory: app
+        run: npm ci
+
+      - name: Install chromium
+        working-directory: app
+        run: npx playwright install --with-deps chromium
+
+      # playwright.config.ts builds the demo app and serves it on :4173 itself.
+      # It runs `e2e/` minus videos/, live/ and scripts/ — see that file for why
+      # each is excluded and where it runs instead.
+      - name: Run the e2e gate
+        working-directory: app
+        run: npx playwright test
+
+      - uses: actions/upload-artifact@v4
+        if: failure()
+        with:
+          name: playwright-report
+          path: app/e2e/report
+          retention-days: 7
