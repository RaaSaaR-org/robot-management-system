{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-2.5-pro",
  "small_model": "google/gemini-2.5-flash",
  "instructions": ["CLAUDE.md", "AGENTS.md"],
  "provider": {
    "google": {
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      }
    }
  },
  "mcp": {
    "mission-control": {
      "type": "local",
      "command": ["mc", "mcp"],
      "enabled": true
    }
  }
}
